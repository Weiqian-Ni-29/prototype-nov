	"impact_pad": {"name": "回震软垫", "type": "P", "price": 150, "source": "commission", "hook": "combat_shield", "params": {"on": "single_enemy_action_hp_loss_gt_20_max_pp", "hp_max_pp": 6, "limit": "a_battle:1"}, "effect": "敌人一次行动打掉队员超过 20% 生命上限的生命，若队员还活着，行动结束时给他加上生命上限 6% 的护盾。每名队员每场一次。", "story": "搬运石料的人把碎布缝进肩垫，重物落下时仍会疼，只是不再把人一下压垮。"},
	"familiar_knock": {"name": "识响门钉", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_damage_reduction", "params": {"when": "same_enemy_as_previous_damaging_action_before_self_action", "scope": "direct", "reduce_pp": 15, "limit": "none"}, "effect": "队员还没轮到自己出手，就又被上次伤到自己的敌人直接攻击，这次受到的直接伤害降低 15%。换一个敌人打伤他，或轮到他行动，就会重新计算。一次攻击的多段伤害不算多次行动。", "story": "住在狭巷的木匠能从门钉的震声分辨熟客，他为常来借工具的人留了一道更厚的门衬。"},
	"tender_gauze": {"name": "柔纱结", "type": "P", "price": 100, "source": "recruit:eve", "hook": "healing_modifier", "params": {"scope": "battle_received_hp_nonrelic", "when": "recipient_hp_ratio_lte_30", "bonus_pp": 20, "limit": "none"}, "effect": "受治疗前生命剩 30% 或更少时，队员从普通技能和道具获得的生命回复提高 20%。遗器治疗和复活照旧。", "story": "纱结被仔细打在伤口之外，包扎的人说，照顾别人时连一个结的位置也值得多想一会儿。"},
	"unburdened_clasp": {"name": "空肩扣", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "combat_stat_modifier", "params": {"when": "self_shield_zero", "stat": "speed", "delta_pp": 8, "until": "condition_ends", "limit": "none"}, "effect": "没有护盾时，队员速度提高 8%。一旦获得护盾，加速就会消失。", "story": "信使卸下沉重的邮袋后仍戴着肩扣，以免忘记路上还有别人等着下一封信。"},
	"last_drop_cup": {"name": "底滴锡杯", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_stat_modifier", "params": {"when": "self_mp_ratio_lte_25", "stat": "defense", "delta_pp": 12, "until": "condition_ends", "limit": "none"}, "effect": "魔力剩四分之一或更少时，队员防御提高 12%。魔力超过四分之一后恢复原防御。", "story": "长途押运的伙计总把最后一口水留在锡杯底，用来润湿缠在掌心的布条。"},
	"rain_listening_pin": {"name": "听雨别针", "type": "P", "price": 65, "source": "field_cache", "hook": "combat_resource", "params": {"on": "rain_first_positive_basic_attack", "restore": {"mp_max_pp": 3}, "targets": "actor", "limit": "a_battle:1"}, "effect": "雨天战斗中，普攻打出伤害后，队员回复魔力上限的 3%。每名队员每场一次。", "story": "裁缝把别针别在窗帘上，听见针脚轻碰窗框，便知道该把晾着的布收进屋了。"},
	"banked_ember_box": {"name": "留炭盒", "type": "P", "price": 100, "source": "shop", "hook": "combat_resource", "params": {"on": "positive_fire_direct_damage_in_burning", "targets": "actor", "restore": {"mp_flat": 3}, "limit": "a_battle:1"}, "effect": "战场燃烧时，队员主动打出火直接伤害后回复 3 点魔力。每名队员每场一次。魔力满时不扣次数。", "story": "炭工把未灭的炭埋进细灰，原想留给清晨开炉，也在盒盖上刻下了小心复燃的告诫。"},
	"rime_thimble": {"name": "凝霜顶针", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "combat_field", "params": {"on": "positive_ice_direct_damage", "from": "wet", "set": "frozen", "actions": 4, "limit": "q_battle:1"}, "effect": "战场湿润且没有冥河时，己方主动打出冰直接伤害后结冰或刷新冰面，持续全场接下来四次行动。全队每场一次。双方每个人在这片冰面上第一次行动后都会迟缓一次。冰化了，湿润还在。", "story": "山村裁衣人把顶针放进冷水里降温，薄霜沿着金属边缘结起时，她便知道炉火该添了。"},
	"copper_rain_comb": {"name": "铜齿雨梳", "type": "P", "price": 150, "source": "field_cache", "hook": "combat_field", "params": {"on": "positive_lightning_direct_damage", "from": "wet", "set": "charged", "actions": 4, "limit": "q_battle:1"}, "effect": "战场湿润且没有冥河时，己方主动打出雷直接伤害后让战场导电或刷新导电，持续全场接下来四次行动。全队每场一次。双方的雷伤环境倍率都增加 0.10，仍在 0.5 到 1.5 之间。导电结束后，湿润还在。", "story": "修屋顶的人把铜齿梳留给学徒，叮嘱雷雨来时先放下金属工具，再惦记没做完的活。"},
	"crossed_wind_chimes": {"name": "交风短铃", "type": "P", "price": 150, "source": "recruit:storm_caller", "hook": "combat_field", "params": {"on": "positive_wind_direct_damage", "from": ["empty", "wet"], "set": "wind_barrier", "actions": 4, "limit": "q_battle:1"}, "effect": "战场没有其他效果或只有湿润，且没有冥河时，己方主动打出风直接伤害后立起或刷新风障，持续全场接下来四次行动。全队每场一次。双方的远程直接伤害都降低 10%。风障消失时，湿润仍保留。", "story": "两片短铃从不在同一方向摆动，挂铃的人说，学会听风也包括听见自己挡住的声音。"},
	"rootbound_bracelet": {"name": "盘根手环", "type": "P", "price": 150, "source": "spirit_farewell", "hook": "combat_field", "params": {"on": "guard", "from": ["empty", "wet"], "set": "root_cover", "actions": 4, "limit": "q_battle:1"}, "effect": "战场没有其他效果或只有湿润，且没有冥河时，己方防御后升起或刷新根掩，持续全场接下来四次行动。全队每场一次。双方受到的直接伤害都降低 5%。主动打出的火直接伤害会移除根掩，湿润仍保留。", "story": "园丁用落下的细根编成手环，提醒搬进新院子的人留一片阴凉，也留一点给陌生人歇脚的地方。"},
	"field_water_sponge": {"name": "吸水海绵", "type": "P", "price": 100, "source": "commission", "hook": "combat_field", "params": {"on": "water_applies_new_wet_in_burning", "from": "wet_finite_after_transition", "extend_actions": 2, "max_actions": 6, "limit": "q_battle:1"}, "effect": "用带湿润效果的水技能打中原本干燥、正在燃烧的战场时，成功施加的湿润多持续两次行动，最多持续六次。全队每场一次。刷新已有湿润不触发。", "story": "灶台旁总挂着这块海绵。帮工会用它浸湿围裙和袖口，好从热气里把锅端下来。"},
	"dripping_spool": {"name": "滴线绕轴", "type": "P", "price": 100, "source": "shop", "hook": "combat_shield", "params": {"on": "positive_water_direct_damage_started_without_wet", "hp_max_pp": 5, "targets": "actor", "limit": "a_battle:1"}, "effect": "队员主动打出水直接伤害，让原本干燥的战场湿润后，获得生命上限 5% 的护盾。每名队员每场一次。", "story": "织工用湿线压住扬起的尘埃，绕轴上的水痕一圈叠一圈，像没有写完的工时簿。"},
	"conductive_needle": {"name": "引流针", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_cost", "params": {"when": "lightning_skill_in_wet", "reduce_flat": 2, "min_flat": 1, "limit": "a_battle:1"}, "effect": "战场湿润时，普通雷技能少花 2 点魔力，最低花 1 点。每名队员每场首次实际省下魔力时触发。冰面或导电下仍有湿润也算，光有冥河不算。", "story": "铜匠用细针试出水槽接缝的走向，确认流路之后，才肯把整块铜板压下去。"},
	"ice_anchor_button": {"name": "冰锚纽扣", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "combat_stat_modifier", "params": {"when": "field_frozen", "stat": "defense", "delta_pp": 20, "extra": {"speed_pp": -5}, "until": "field_changes", "limit": "none"}, "effect": "有冰面时，己方队员防御提高 20%，速度再降低 5%。冰面造成的迟缓另外算。", "story": "冰河旁的搬运工把重纽扣缝在外衣下摆，风吹不起来，走路却确实比旁人慢些。"},
	"grounding_heel": {"name": "泄电跟铁", "type": "P", "price": 100, "source": "shop", "hook": "combat_damage_reduction", "params": {"when": "field_charged_and_incoming_lightning", "scope": "direct", "reduce_pp": 20, "limit": "none"}, "effect": "战场导电时，己方队员受到的敌方雷直接伤害降低 20%，与其他装备和遗器合计最多减免 50%。战场本身的雷伤加成照旧。", "story": "修钟人给木梯包上这块跟铁，第一次试用前，仍先检查了脚下的水迹。"},
	"river_brace": {"name": "涉流腕撑", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_stat_modifier", "params": {"on": "guard_in_river", "stat": "defense", "delta_pp": 15, "until": "next_own_action_end_or_field_change", "limit": "none"}, "effect": "队员在冥河中防御后，防御力提高 15%，持续到自己下一次有效行动结束，离开冥河也会消失。再次防御只刷新时间。", "story": "摆渡学徒靠腕撑握住湿滑的撑杆，师傅只教他站稳，没有许诺水流会因此变轻。"},
	"rain_route_tag": {"name": "雨路签", "type": "P", "price": 100, "source": "commission", "hook": "map_ap", "params": {"on": "paid_move_in_rain", "ap_flat": 1, "targets": "local_mover", "limit": "q_day:1"}, "effect": "健康队员在雨天花精力移动后，返还 1 点精力。全队每天一次。", "story": "山脚客栈把容易积水的路口写在小签上，旅人回来时，常会再补上一条更稳的走法。"},
	"mixed_soil_pouch": {"name": "三土囊", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "map_ap", "params": {"on": "third_distinct_destination_terrain_today", "ap_flat": 1, "targets": "local_mover", "limit": "a_day:1"}, "effect": "队员一天内花精力走进三种不同的地形后，回复 1 点精力。每名队员每天一次。", "story": "测路人从山坡、林边和石道各取一撮土，回程时凭指间的触感回想哪里最费脚力。"},
	"ash_filter_patch": {"name": "滤灰布章", "type": "P", "price": 100, "source": "recruit:ashhorn", "hook": "combat_damage_reduction", "params": {"when": "burning_tick", "scope": "burning_field_tick", "reduce_pp": 25, "limit": "none"}, "effect": "战场燃烧时，队员每次受到的灼烧伤害降低 25%，与其他减伤共用上限。火直接伤害照旧。", "story": "烧窑工把最厚的一层滤灰布剪成小章，送人前还仔细抖净了缝里的碎炭。"},
	"thaw_water_vial": {"name": "解冻水瓶", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "combat_resource", "params": {"on": "own_natural_fire_melts_frozen", "restore": {"energy_flat": 8}, "targets": "actor", "limit": "a_battle:1"}, "effect": "队员主动打出火直接伤害，真正融掉冰面后，获得 8 点能量。每名队员每场一次。", "story": "水瓶曾冻在门槛边，邻居用温布一点点化开瓶口，没有因为着急就把玻璃敲碎。"},
	"field_dial": {"name": "场息圆盘", "type": "P", "price": 65, "source": "shop", "hook": "combat_info", "params": {"view": "field_remaining_actions_and_next_burning_tick", "limit": "none"}, "effect": "共鸣时，战斗界面会显示战场效果、还剩多少次全场行动、多久后会再烧一次，以及哪些效果会影响双方。", "story": "旧工坊用圆盘记录炉温变化，最后一位看炉人把容易误读的刻度重新描了一遍。"},
	"waterline_thread": {"name": "水线丝", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_heal", "params": {"on": "positive_water_direct_damage_started_in_wet", "targets": "actor", "hp_max_pp": 3, "limit": "a_battle:2"}, "effect": "战场原本湿润时，队员主动打出水直接伤害后，回复生命上限的 3%。每名队员每场最多两次，多段或打中多名敌人都算一次。冰面和导电下仍有湿润也算，光有冥河不算。", "story": "渔网修补者用一根颜色浅些的丝标出水线，网收回来时，总能先找到最容易磨损的那一段。"},
	"unpacking_mat": {"name": "开箱垫布", "type": "P", "price": 65, "source": "field_cache", "hook": "map_ap", "params": {"on": "field_cache_first_claim_positive_loot", "ap_flat": 1, "targets": "healthy_local_claimant", "limit": "run_object:1"}, "effect": "健康队员第一次从一个野外宝箱拿到物品或灯铢后，回复 1 点精力。每个箱子整次远征只算一次。", "story": "搬家的人把杂物摊在垫布上，一眼就能找出该先装进包里的东西，少走许多回头路。"},
	"survey_tally": {"name": "踏查筹", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "map_info", "params": {"view": "current_region_visible_milestone_progress", "limit": "none"}, "effect": "探索面板会显示本区域的探索进度、还差多少能领里程碑奖励，以及有多少个已发现、能到达但还没去过的地点。", "story": "绘图人每走过一处路口便挪一根筹，旁人能看到他的进度，也能看到他尚未走过的空白。"},
	"rest_step_counter": {"name": "歇脚计步扣", "type": "P", "price": 100, "source": "shop", "hook": "rest_bonus", "params": {"restore": {"ap_flat": 1}, "targets": "healthy_rest_participants_with_positive_base_hp_or_mp", "require_positive": "base_hp_or_mp", "limit": "q_day:1"}, "effect": "在休息地点实际回复了生命或魔力的健康队员，各回复 1 点精力。全队每天最多触发一次。", "story": "客栈木工在长凳边钉了小扣，提醒赶路人坐下时把鞋带重新系好，再起身走下一段。"},
	"season_patchwork": {"name": "四季拼毯", "type": "P", "price": 100, "source": "recruit:seasons", "hook": "rest_bonus", "params": {"restore": {"hp_max_pp": 10}, "targets": "healthy_rest_participants_with_positive_base_hp", "require_positive": "base_hp", "limit": "q_day:1"}, "effect": "休息时实际回了血的健康队员，各额外回复生命上限的 10%。全队每天最多触发一次。", "story": "四块旧布来自不同季节修补过的衣物，缝成一张毯子后，谁也不再追问哪一块更暖。"},
	"shared_kettle_lid": {"name": "分茶壶盖", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "rest_bonus", "params": {"restore": {"mp_max_pp": 12}, "targets": "lowest_mp_ratio_positive_base_mp_rest_participant", "require_positive": "base_mp", "tie": "actor_id", "limit": "q_day:1"}, "effect": "休息时，从回过魔力但还没回满的健康队员中，给剩余魔力比例最低的一人再回复其魔力上限的 12%。全队每天一次。", "story": "茶馆主人用壶盖分辨哪杯茶还没续过，最后一壶总先倒给说得最少、看起来最累的人。"},
	"market_window": {"name": "市窗木框", "type": "P", "price": 65, "source": "shop", "hook": "map_info", "params": {"view": "revealed_shop_existing_stock_and_prices", "limit": "none"}, "effect": "在地图上就能看见已发现商店里已经摆出的货和当前价格。买东西还是得到店里。", "story": "行商把货单挂在木框里，即使摊位暂时无人照看，来客也不用白等一场。"},
	"caution_compass": {"name": "慎行罗盘", "type": "P", "price": 100, "source": "field_cache", "hook": "map_info", "params": {"view": "nearest_public_elite_direction", "radius": 3, "limit": "none"}, "effect": "显示当前地块周围三圈内最近的已公开精英战斗地点的方向和距离。", "story": "领路人把危险岔口记在罗盘背面，并在最醒目的地方写下：知道在哪里，不等于必须前往。"},
	"honest_ledger": {"name": "实记账簿", "type": "P", "price": 65, "source": "commission", "hook": "map_info", "params": {"view": "accepted_commission_actual_requirements_and_claim_state", "limit": "none"}, "effect": "在委托界面显示已接委托做到了哪一步、怎么交差，以及奖励领了没有。", "story": "账房把听来的消息和亲手验过的货分成两栏，宁可留下空格，也不把猜测写成结清。"},
	"terrain_caliper": {"name": "路费卡尺", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "map_info", "params": {"view": "revealed_move_cost_breakdown", "radius": 2, "limit": "none"}, "effect": "显示周围两圈内已发现的可走路段。你可以查看本地队员走每段路原本要花多少精力、减免了多少、最后要花多少。最低花 1 点。", "story": "修路的老师傅用卡尺量石缝，也量每一段坡给行人添了多少负担。"},
	"cloud_almanac": {"name": "云迹小历", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "weather_forecast", "params": {"days": 2, "weather_partition": "rain_or_nonrain", "limit": "none"}, "effect": "预报接下来两天会不会下雨。天气规则改变后，预报也会跟着变。", "story": "田边记雨的人把猜错的日子也留在小历上，后来的读者因此更愿意相信那些仔细的注记。"},
	"uphill_kneepad": {"name": "上坡膝垫", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_shield", "params": {"arm": "local_paid_move_cost_gte_3", "on": "next_battle_first_deployment_same_day", "hp_max_pp": 8, "targets": "armed_actor", "expires": "day_end_or_next_battle_end_or_unattune", "limit": "a_day:1"}, "effect": "队员花至少 3 点精力走完一次后，当天在下一场战斗里第一次上场时，获得生命上限 8% 的护盾。每名队员每天最多准备一次。解除共鸣、当天结束或打完下一场后，没用上的准备会消失。", "story": "采药人把膝垫磨出了斜斜的纹路，爬上坡顶时，他总先拍掉泥土再继续赶路。"},
