	"fallen_standard_tassel": {"name": "垂旗流苏", "type": "P", "price": 150, "source": "field_cache", "hook": "combat_shield", "params": {"on": "first_other_ally_defeated_by_enemy", "targets": "all_living_allied_participants", "hp_max_pp": 6, "limit": "q_battle:1"}, "effect": "每场第一次有队员被敌人直接击倒时，其他仍健康的参战队员各获得生命上限 6% 的护盾。", "story": "撤离的人从倒下的旗杆上剪走流苏，用来绑紧最后一辆载伤员的车。"},
	"narrow_margin": {"name": "窄边书签", "type": "P", "price": 100, "source": "shop", "hook": "combat_cost", "params": {"when": "self_hp_ratio_lte_25", "reduce_pp": 20, "min_flat": 1, "limit": "none"}, "effect": "队员生命剩四分之一或更少时，普通技能的魔力消耗降低 20%，向上取整。原本要花魔力的技能至少花 1 点。", "story": "穷讲师买不起新纸，把旧军令裁成长条作书签。学生总拿去看背面的字，他便说，先学会读完，再决定信不信。"},
	"impact_pad": {"name": "回震软垫", "type": "P", "price": 150, "source": "commission", "hook": "combat_shield", "params": {"on": "single_enemy_action_hp_loss_gt_20_max_pp", "hp_max_pp": 6, "limit": "a_battle:1"}, "effect": "敌人一次行动打掉队员超过 20% 生命上限的生命，若队员还活着，行动结束时给他加上生命上限 6% 的护盾。每名队员每场一次。", "story": "搬运石料的人把碎布缝进肩垫，重物落下时仍会疼，只是不再把人一下压垮。"},
	"familiar_knock": {"name": "识响门钉", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_damage_reduction", "params": {"when": "same_enemy_as_previous_damaging_action_before_self_action", "scope": "direct", "reduce_pp": 15, "limit": "none"}, "effect": "队员还没轮到自己出手，就又被上次伤到自己的敌人直接攻击，这次受到的直接伤害降低 15%。换一个敌人打伤他，或轮到他行动，就会重新计算。一次攻击的多段伤害不算多次行动。", "story": "狭巷木匠替邻居做了这枚门钉，三轻一重是借工具的敲法。搜兵来时也学着敲，屋里的人却听出了铁护腕撞门的杂响。"},
	"tender_gauze": {"name": "柔纱结", "type": "P", "price": 100, "source": "recruit:eve", "hook": "healing_modifier", "params": {"scope": "battle_received_hp_nonrelic", "when": "recipient_hp_ratio_lte_30", "bonus_pp": 20, "limit": "none"}, "effect": "受治疗前生命剩 30% 或更少时，队员从普通技能和道具获得的生命回复提高 20%。遗器治疗和复活照旧。", "story": "纱结被仔细打在伤口之外，包扎的人说，照顾别人时连一个结的位置也值得多想一会儿。"},
	"unburdened_clasp": {"name": "空肩扣", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "combat_stat_modifier", "params": {"when": "self_shield_zero", "stat": "speed", "delta_pp": 8, "until": "condition_ends", "limit": "none"}, "effect": "没有护盾时，队员速度提高 8%。一旦获得护盾，加速就会消失。", "story": "信使的肩扣断过一次，满袋军令撒进了泥水。他捡到天黑，唯独把那封要封死城门的命令留在了最深的水坑里。"},
	"last_drop_cup": {"name": "底滴锡杯", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_stat_modifier", "params": {"when": "self_mp_ratio_lte_25", "stat": "defense", "delta_pp": 12, "until": "condition_ends", "limit": "none"}, "effect": "魔力剩四分之一或更少时，队员防御提高 12%。魔力超过四分之一后恢复原防御。", "story": "押运伙计总用锡杯接住分水时漏下的几滴。领队笑他小气，后来水车翻在沙坡下，第一个来借杯的也是领队。"},
	"rain_listening_pin": {"name": "听雨别针", "type": "P", "price": 65, "source": "field_cache", "hook": "combat_resource", "params": {"on": "rain_first_positive_basic_attack", "restore": {"mp_max_pp": 3}, "targets": "actor", "limit": "a_battle:1"}, "effect": "雨天战斗中，普攻打出伤害后，队员回复魔力上限的 3%。每名队员每场一次。", "story": "裁缝赶着给婚礼改衣，听见雨打窗框也不肯停针。赶来取衣的人把伞往旁边一扔，挽起袖子，先替她收下了满院晾布。"},
	"banked_ember_box": {"name": "留炭盒", "type": "P", "price": 100, "source": "shop", "hook": "combat_resource", "params": {"on": "positive_fire_direct_damage_in_burning", "targets": "actor", "restore": {"mp_flat": 3}, "limit": "a_battle:1"}, "effect": "战场燃烧时，队员主动打出火直接伤害后回复 3 点魔力。每名队员每场一次。魔力满时不扣次数。", "story": "炭工把火种埋进细灰，留到清晨开炉。逃难时，他带走了这一盒，没带走炉子；到了新村，第一炉铁便从盒里借了火。"},
	"rime_thimble": {"name": "凝霜顶针", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "combat_field", "params": {"on": "positive_ice_direct_damage", "from": "wet", "set": "frozen", "actions": 4, "limit": "q_battle:1"}, "effect": "战场湿润且没有冥河时，己方主动打出冰直接伤害后结冰或刷新冰面，持续全场接下来四次行动。全队每场一次。双方每个人在这片冰面上第一次行动后都会迟缓一次。冰化了，湿润还在。", "story": "山村裁衣人连夜补袄，天亮把顶针放到窗边，针上已经结了霜。来取衣的挑夫嫌贵，她指着窗缝说，价里也算我挨的这一夜冻。"},
	"copper_rain_comb": {"name": "铜齿雨梳", "type": "P", "price": 150, "source": "field_cache", "hook": "combat_field", "params": {"on": "positive_lightning_direct_damage", "from": "wet", "set": "charged", "actions": 4, "limit": "q_battle:1"}, "effect": "战场湿润且没有冥河时，己方主动打出雷直接伤害后让战场导电或刷新导电，持续全场接下来四次行动。全队每场一次。双方的雷伤环境倍率都增加 0.10，仍在 0.5 到 1.5 之间。导电结束后，湿润还在。", "story": "铜齿原是屋顶泄水槽上拦落叶的小栅。雷击把旁边的木梁劈开后，修屋人拆下这截焦黑的铜，留给总爱爬高看雨的孩子。"},
	"crossed_wind_chimes": {"name": "交风短铃", "type": "P", "price": 150, "source": "recruit:storm_caller", "hook": "combat_field", "params": {"on": "positive_wind_direct_damage", "from": ["empty", "wet"], "set": "wind_barrier", "actions": 4, "limit": "q_battle:1"}, "effect": "战场没有其他效果或只有湿润，且没有冥河时，己方主动打出风直接伤害后立起或刷新风障，持续全场接下来四次行动。全队每场一次。双方的远程直接伤害都降低 10%。风障消失时，湿润仍保留。", "story": "两片短铃挂在船棚的两个角，风一转，响声也跟着换边。老船工闭着眼都能听出变化，儿子却总以为父亲是在装睡躲活。"},
	"rootbound_bracelet": {"name": "盘根手环", "type": "P", "price": 150, "source": "spirit_farewell", "hook": "combat_field", "params": {"on": "guard", "from": ["empty", "wet"], "set": "root_cover", "actions": 4, "limit": "q_battle:1"}, "effect": "战场没有其他效果或只有湿润，且没有冥河时，己方防御后升起或刷新根掩，持续全场接下来四次行动。全队每场一次。双方受到的直接伤害都降低 5%。主动打出的火直接伤害会移除根掩，湿润仍保留。", "story": "被征走的园丁把修下的细根编成手环。军官要他摘掉，他说这是雇主家的东西，赔得起才摘；军官看了半天，嫌晦气走开了。"},
	"field_water_sponge": {"name": "吸水海绵", "type": "P", "price": 100, "source": "commission", "hook": "combat_field", "params": {"on": "water_applies_new_wet_in_burning", "from": "wet_finite_after_transition", "extend_actions": 2, "max_actions": 6, "limit": "q_battle:1"}, "effect": "用带湿润效果的水技能打中原本干燥、正在燃烧的战场时，成功施加的湿润多持续两次行动，最多持续六次。全队每场一次。刷新已有湿润不触发。", "story": "船上的厨子拿海绵擦桌，也拿它浸湿将被火油引燃的篷布。灭火后大家都夸厨子，他却只惦记那锅倒在甲板上的汤。"},
	"dripping_spool": {"name": "滴线绕轴", "type": "P", "price": 100, "source": "shop", "hook": "combat_shield", "params": {"on": "positive_water_direct_damage_started_without_wet", "hp_max_pp": 5, "targets": "actor", "limit": "a_battle:1"}, "effect": "队员主动打出水直接伤害，让原本干燥的战场湿润后，获得生命上限 5% 的护盾。每名队员每场一次。", "story": "织坊停工后，工人把剩线分走。一个人怕领得太少，先把线浸湿压秤，结果赶路时滴了一路水，被同伴笑了许多年。"},
	"conductive_needle": {"name": "引流针", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_cost", "params": {"when": "lightning_skill_in_wet", "reduce_flat": 2, "min_flat": 1, "limit": "a_battle:1"}, "effect": "战场湿润时，普通雷技能少花 2 点魔力，最低花 1 点。每名队员每场首次实际省下魔力时触发。冰面或导电下仍有湿润也算，光有冥河不算。", "story": "铜匠曾用这根细针挑出旧符槽里的碎屑。学徒嫌太慢，想整块熔掉重铸；铜匠把拆出的银线放到秤上，问他现在还急不急。"},
	"ice_anchor_button": {"name": "冰锚纽扣", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "combat_stat_modifier", "params": {"when": "field_frozen", "stat": "defense", "delta_pp": 20, "extra": {"speed_pp": -5}, "until": "field_changes", "limit": "none"}, "effect": "有冰面时，己方队员防御提高 20%，速度再降低 5%。冰面造成的迟缓另外算。", "story": "纽扣来自冰河搬运队的一件旧大衣。掉进裂缝的人被衣襟挂住，等同伴拉上来，衣已撕开，只剩这枚扣还卡在岩隙里。"},
	"grounding_heel": {"name": "泄电跟铁", "type": "P", "price": 100, "source": "shop", "hook": "combat_damage_reduction", "params": {"when": "field_charged_and_incoming_lightning", "scope": "direct", "reduce_pp": 20, "limit": "none"}, "effect": "战场导电时，己方队员受到的敌方雷直接伤害降低 20%，与其他装备和遗器合计最多减免 50%。战场本身的雷伤加成照旧。", "story": "引雷工坊给木架装上跟铁，用铜索连到埋入湿土的长钉。学徒第一次嫌铜索碍脚，拆掉后烧坏了半座架子，赔了三个月工钱。"},
	"river_brace": {"name": "涉流腕撑", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_stat_modifier", "params": {"on": "guard_in_river", "stat": "defense", "delta_pp": 15, "until": "next_own_action_end_or_field_change", "limit": "none"}, "effect": "队员在冥河中防御后，防御力提高 15%，持续到自己下一次有效行动结束，离开冥河也会消失。再次防御只刷新时间。", "story": "摆渡学徒戴着腕撑练了一冬，终于能把空船撑过急弯。春天第一次载客便撞上岸，师傅没骂，只让他先把摔坏的货赔了。"},
	"rain_route_tag": {"name": "雨路签", "type": "P", "price": 100, "source": "commission", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "客栈把积水路口写在小签上，住店才送。一个赶路人抄下内容留在门外，掌柜气得拔了木牌，第二天却又把它立了回去。"},
	"mixed_soil_pouch": {"name": "三土囊", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "相邻三村为一片坡地争了多年，各拿一把土说该归自己。来调停的人把三把土装进同一个袋子，回去后却再也分不清哪把是谁的。"},
	"ash_filter_patch": {"name": "滤灰布章", "type": "P", "price": 100, "source": "recruit:ashhorn", "hook": "combat_damage_reduction", "params": {"when": "burning_tick", "scope": "burning_field_tick", "reduce_pp": 25, "limit": "none"}, "effect": "战场燃烧时，队员每次受到的灼烧伤害降低 25%，与其他减伤共用上限。火直接伤害照旧。", "story": "烧窑工把旧滤灰布缝在领口，夜班回来，露在外面的皮肤全是黑的。孩子摸到那块干净的布章，就知道可以扑进他怀里。"},
	"thaw_water_vial": {"name": "解冻水瓶", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "combat_resource", "params": {"on": "own_natural_fire_melts_frozen", "restore": {"energy_flat": 8}, "targets": "actor", "limit": "a_battle:1"}, "effect": "队员主动打出火直接伤害，真正融掉冰面后，获得 8 点能量。每名队员每场一次。", "story": "水瓶曾冻在门槛边，邻居用温布一点点化开瓶口，没有因为着急就把玻璃敲碎。"},
	"field_dial": {"name": "场息圆盘", "type": "P", "price": 65, "source": "shop", "hook": "combat_info", "params": {"view": "field_remaining_actions_and_next_burning_tick", "limit": "none"}, "effect": "共鸣时，战斗界面会显示战场效果、还剩多少次全场行动、多久后会再烧一次，以及哪些效果会影响双方。", "story": "炉坊掌事把铜盘刻度改小了一格，想催工人多烧一炉。老看炉人没争，把烧裂的第一批铸件搬到了掌事门前。"},
	"waterline_thread": {"name": "水线丝", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_heal", "params": {"on": "positive_water_direct_damage_started_in_wet", "targets": "actor", "hp_max_pp": 3, "limit": "a_battle:2"}, "effect": "战场原本湿润时，队员主动打出水直接伤害后，回复生命上限的 3%。每名队员每场最多两次，多段或打中多名敌人都算一次。冰面和导电下仍有湿润也算，光有冥河不算。", "story": "渔人拿浅色丝线标出网最深的一段。守军征网封河后，他夜里摸着那段丝线割开一个口，天明前把家里的小船送了出去。"},
	"unpacking_mat": {"name": "开箱垫布", "type": "P", "price": 65, "source": "field_cache", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "行商把货往垫布上一摊，就知道少了什么。学徒第一次偷吃干粮时特意补上了石子，却忘了石子滚起来会响。"},
	"survey_tally": {"name": "踏查筹", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "map_info", "params": {"view": "current_region_visible_milestone_progress", "limit": "none"}, "effect": "探索面板会显示本区域的探索进度、还差多少能领里程碑奖励，以及有多少个已发现、能到达但还没去过的地点。", "story": "勘路队每过一处路口便在绳上添一根木筹。雇主嫌他们绕远路多收钱，领队便解下筹子，请雇主亲自再走一遍。"},
	"rest_step_counter": {"name": "歇脚计步扣", "type": "P", "price": 100, "source": "shop", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "扣片原装在驿夫的腰带上，每到一个驿站拨一下。老驿夫退休后仍每天拨动它，孙辈便在院里给他摆了几张小凳，当作沿途的歇脚处。"},
	"season_patchwork": {"name": "四季拼毯", "type": "P", "price": 100, "source": "recruit:seasons", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "四块布是母亲从孩子历年穿小的衣服上裁的。孩子长大参军，嫌毯子花，没带走；入冬来信，头一句便问能不能把毯子送来。"},
	"shared_kettle_lid": {"name": "分茶壶盖", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "小茶馆只剩一把壶，忙时便拿壶盖当杯。老板最不愿借给吵着赊账的熟客，可那人一来，手还是先把盖子摘下了。"},
	"market_window": {"name": "市窗木框", "type": "P", "price": 65, "source": "shop", "hook": "map_info", "params": {"view": "revealed_shop_existing_stock_and_prices", "limit": "none"}, "effect": "在地图上就能看见已发现商店里已经摆出的货和当前价格。买东西还是得到店里。", "story": "行商把货样挂在木框上，背后藏着现货。关兵来搜时，他把便宜的摆满前面；收完税再一转框，贵货又重新露出来。"},
	"caution_compass": {"name": "慎行罗盘", "type": "P", "price": 100, "source": "field_cache", "hook": "map_info", "params": {"view": "nearest_public_elite_direction", "radius": 3, "limit": "none"}, "effect": "显示当前地块周围三圈内最近的已公开精英战斗地点的方向和距离。", "story": "领路人从不把罗盘借给只想抄近路的人。有人给了双倍价钱借走，三日后回来还盘，罗盘没坏，同行的骡子却少了两头。"},
	"honest_ledger": {"name": "实记账簿", "type": "P", "price": 65, "source": "commission", "hook": "map_info", "params": {"view": "accepted_commission_actual_requirements_and_claim_state", "limit": "none"}, "effect": "在委托界面显示已接委托做到了哪一步、怎么交差，以及奖励领了没有。", "story": "军仓账房把实收的粮和长官报上的粮分成两栏。上头要他改成一样，他把账本塞给来领粮的队长，自己翻窗逃了。"},
	"terrain_caliper": {"name": "路费卡尺", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "map_info", "params": {"view": "revealed_land_terrain", "radius": 2, "limit": "none"}, "effect": "显示周围两圈内已发现的可通行地块和地形。", "story": "修路师傅用卡尺量碎石的大小，不合用的宁可重凿。包工的人想省工，往他碗里添肉，他吃完照旧退了那一车石头。"},
	"cloud_almanac": {"name": "云迹小历", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "weather_forecast", "params": {"days": 2, "weather_partition": "rain_or_nonrain", "limit": "none"}, "effect": "预报接下来两天会不会下雨。天气规则改变后，预报也会跟着变。", "story": "记雨的农人连猜错的日子也没撕掉，旁边还写着当时怎么想的。儿子拿去押第二天晴雨，输的钱后来都记在封底。"},
	"uphill_kneepad": {"name": "上坡膝垫", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_shield", "params": {"arm": "enter_mountain", "on": "next_battle_first_deployment_same_day", "hp_max_pp": 8, "targets": "armed_actor", "expires": "day_end_or_next_battle_end_or_unattune", "limit": "a_day:1"}, "effect": "队员随旅人走进山地后，当天在下一场战斗里第一次上场时，获得生命上限 8% 的护盾。每名队员每天最多准备一次。解除共鸣、当天结束或打完下一场后，没用上的准备会消失。", "story": "采药人把膝垫磨出了斜斜的纹路，爬上坡顶时，他总先拍掉泥土再继续赶路。"},
	"milestone_waterbag": {"name": "路碑水囊", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "map_resource", "params": {"on": "exploration_milestone_first_positive_reward_claim", "targets": "all_healthy_joined_global", "restore": {"mp_max_pp": 15}, "limit": "run_object:1"}, "effect": "第一次领到一个探索里程碑的奖励后，全体健康队员各回复魔力上限的 15%。每个里程碑只触发一次。", "story": "商队把水囊挂在最后一辆车上，掉队的人赶上来就能喝。领队怕有人偷懒，曾把车赶到最前；走到下一个路碑，自己先回头去接人了。"},
	"bargaining_counter": {"name": "议价铜筹", "type": "P", "price": 150, "source": "shop", "hook": "economy_discount", "params": {"channel": "shop_buy", "reduce_pp": 10, "when": "all_valid_purchases", "limit": "none"}, "effect": "全队买东西时，基础买价降低 10%。与其他买价优惠合计最多便宜 25%，买价始终高于卖价。", "story": "老商人把铜筹推来推去，买家看不明白就会少算一层价。商人的女儿后来接手摊位，把每笔筹都排成直线，父女为此吵过好几次。"},
	"workshop_gauge": {"name": "工坊规尺", "type": "P", "price": 150, "source": "commission", "hook": "economy_discount", "params": {"channel": "enhancement_fee", "reduce_pp": 15, "when": "all_valid_enhancements", "limit": "none"}, "effect": "全队强化装备时，基础灯铢费用降低 15%，与其他强化优惠合计最多便宜 25%。", "story": "老师傅走前把规尺留给学徒，唯独没留下自己的印。学徒气了一冬，等做出第一批不用返工的铆件，才另刻了一枚自己的。"},
	"fair_weight_seal": {"name": "公秤封签", "type": "P", "price": 150, "source": "spirit_farewell", "hook": "economy_sale", "params": {"bonus_pp": 15, "limit": "none"}, "effect": "全队卖东西时，基础卖价提高 15%，与其他卖价加成合计最多提高 25%。卖价始终低于买价。", "story": "集市公秤被发现暗藏铁块后，卖盐的和买粮的一起堵了秤房。新封签上压着两家的印，谁想拆开，得把双方都叫来。"},
	"commission_carbon": {"name": "委托复写纸", "type": "P", "price": 100, "source": "commission", "hook": "economy_reward", "params": {"source": "commission", "bonus_pp": 15, "limit": "run_object:1"}, "effect": "第一次领取有灯铢奖励的委托时，额外获得原奖励灯铢的 15%。每份奖励只算一次。", "story": "跑腿人给军营送完药，领钱时却被说成只送了半车。他从靴筒里抽出留底的复写纸，指着领药官亲手画的押，在帐外念到有人肯出来。"},
	"farewell_receipt": {"name": "送别留据", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "map_resource", "params": {"source": "spirit_farewell", "targets": "healthy_local_operator", "restore": {"mp_flat": 6}, "limit": "q_day:1"}, "effect": "健康队员亲自送别亡灵后，回复 6 点魔力。全队每天一次，每场送别也只算一次。魔力满时不扣次数。", "story": "纸上写着收殓工收到的一枚戒指和两件旧衣。家属已经付不起余钱，工人便把纸交还，说东西先拿回去，账等开春再算。"},
	"survey_bonus_stamp": {"name": "勘路奖印", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "economy_discount", "params": {"channel": "shop_buy", "when": "visited_count_gte_60", "reduce_pp": 10, "limit": "q_day:1"}, "effect": "本次远征走过 60 个不同地块后，每天第一笔能享受该优惠的购物便宜 10%。光揭开地图迷雾不算。所有买价优惠合计最多便宜 25%，买价始终高于卖价。", "story": "勘路人带回一条能绕过塌桥的路，商会给了他奖印，却拖着不付工钱。他便挂着印去替另一支商队带路，让旧雇主自己等。"},
	"first_fit_pattern": {"name": "初配纸样", "type": "P", "price": 100, "source": "field_cache", "hook": "economy_discount", "params": {"channel": "enhancement_fee", "reduce_pp": 10, "when": "first_discounted_enhancement_per_equipment_instance", "limit": "run_object:1"}, "effect": "每件装备第一次享受这项优惠强化时，额外减去基础强化费用的 10%。所有强化优惠合计最多便宜 25%。卖了再买回来也只算一次。", "story": "老裁工把纸样交给常年外出的女儿，说到了哪儿都能照着做衣。三年后女儿回来，纸样早不合身，却还折得整整齐齐。"},
	"price_pair_slip": {"name": "双价对照签", "type": "P", "price": 65, "source": "shop", "hook": "map_info", "params": {"view": "current_shop_final_buy_sell_and_discount_floor", "limit": "none"}, "effect": "在商店里同时显示已上架商品的实际买价、卖价，以及为保证买价高于卖价而少给了多少优惠。", "story": "签上两栏原是收购价与卖出价。掌柜总把低的那栏翻到外面，伙计接店后索性把两栏一起挂出，附近的同行因此不大愿意来喝茶。"},
	"breath_reserve": {"name": "蓄息口哨", "type": "P", "price": 100, "source": "commission", "hook": "combat_resource", "params": {"arm": "normal_skill_positive_mp_payment", "on": "next_guard", "restore": {"energy_flat": 5}, "targets": "actor", "limit": "a_battle:1"}, "effect": "队员用普通技能花过魔力后，在下一次防御结束时获得 5 点能量。每名队员每场一次。能量满时不扣次数，但要再花魔力才能重新准备。", "story": "山路领唱人走到风口，总吹一声长哨叫队伍靠拢。有人嫌难听，替他做了这只小哨；他却留着旧的，说新哨吹不出自己的调。"},
	"tracking_notch": {"name": "追纹刻片", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_damage_bonus", "params": {"when": "consecutive_basic_attack_same_recorded_target", "bonus_pp": 12, "record_target": "lowest_id_positive_damage_target", "limit": "none"}, "effect": "普攻造成伤害后，记下其中一个被打中的敌人。该队员下一次行动若仍是普攻且打中它，只对它增伤 12%。再根据这次普攻更新目标。其他行动会清掉记录。", "story": "猎人追过一头逃出套索的山兽，在骨片上刻了十二道痕。第十三天他空手回来，把骨片扔进工具箱，改去替村里修栅栏。"},
	"ready_sandal_loop": {"name": "整履环", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "combat_action_delay", "params": {"when": "first_deployment", "phase": "initial_wait", "reduce_pp": 15, "limit": "a_battle:1"}, "effect": "每名队员每场首次上场时，第一次出手前的等待缩短 15%，最快仍受行动速度上限限制。换下再上也只算一次。", "story": "新兵鞋带总散，班长便把铁环缝进鞋面，让带子从里面穿过去。新兵升了职，把环拆下挂在腰间；替部下扎鞋时，环总会碰得叮当响。"},
	"closing_chime": {"name": "止战小磬", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "combat_resource", "params": {"on": "self_direct_damage_first_defeat_of_enemy", "restore": {"mp_max_pp": 6}, "targets": "actor", "limit": "a_battle:1"}, "effect": "队员用普攻、技能或终结技直接让一名敌人本场首次倒下时，回复魔力上限的 6%。每名队员每场一次。场地和遗器额外伤害击倒的不算。", "story": "两拨伤兵在药棚里争起旧仇，医者敲着小磬叫守卫来。人被分开以后，他又敲了一下，说现在才轮到他发火。"},
	"sheltered_stitch": {"name": "庇身缝线", "type": "P", "price": 100, "source": "shop", "hook": "combat_heal", "params": {"arm": "guard_then_enemy_direct_hp_loss", "on": "next_own_action_start", "targets": "surviving_actor", "hp_max_pp": 5, "limit": "a_battle:1"}, "effect": "队员防御后，如果在轮到自己行动前又被敌人的直接伤害扣掉生命，下一次行动开始时回复生命上限的 5%。每名队员每场一次，必须仍健康存活。只打掉护盾不算。", "story": "修篷人把最牢的一针藏在折边里，风雨过去后，人们才发现那处不起眼的缝线一直没有松。"},
	"witness_slate": {"name": "亲历石板", "type": "P", "price": 65, "source": "commission", "hook": "combat_info", "params": {"view": "observed_enemy_action_records_this_run", "limit": "none"}, "effect": "可查这次远征里亲眼见过的敌人招式。记录包括技能名、元素、打了谁、扣了多少生命和护盾，以及当时的战场效果。", "story": "一个随军石匠在板上刻下被烧村落的名字，刻到第七个时，队长叫他停手。石匠把板翻了个面，第二天从背面接着刻。"},
	"clean_bandage_roll": {"name": "净布绷带卷", "type": "C", "price": 40, "source": "shop", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"hp_max_pp": 30}, "limit": "none"}, "effect": "探索时，健康队员使用后回复自身生命上限的 30%。不能解除伤病或复活。生命没有实际回复时不消耗。", "story": "织坊给军官做的细布被退了货，理由是颜色不匀。工人把布洗净剪成绷带，送去药棚；军官伤了手，后来也缠上了同一批。"},
	"mint_distillate": {"name": "薄荷澄露", "type": "C", "price": 40, "source": "field_cache", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"mp_max_pp": 30}, "limit": "none"}, "effect": "探索时，健康队员使用后回复自身魔力上限的 30%。魔力已满时不消耗。", "story": "配药学徒第一次蒸出的薄荷露气味太冲，师傅一闻就打了喷嚏。学徒怕挨骂，先把瓶子藏起来，翌日却发现师傅正拿着它给自己提神。"},
	"pressed_travel_ration": {"name": "压实路粮", "type": "C", "price": 65, "source": "shop", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "围城时磨坊把麦粒与盐压成硬块，士兵要用刀背敲开才吃得动。解围后有人专程回来买，磨坊主说终于能磨细面了，何苦还嚼这个。"},
	"balanced_broth_jar": {"name": "调和汤罐", "type": "C", "price": 65, "source": "spirit_farewell", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"hp_max_pp": 15, "mp_max_pp": 15}, "limit": "none"}, "effect": "探索时，健康队员使用后，各回复自身生命上限和魔力上限的 15%。两项都没回复时不消耗，有一项回复就用掉一份。", "story": "营里的厨子把药草与碎米煮进同一锅，嫌苦的人排了半天队，最后还是把碗舔净。军医夸他会调味，他说只是盐放得够。"},
	"bitter_exchange_vial": {"name": "苦酿换息瓶", "type": "C", "price": 100, "source": "commission", "hook": "resource_use", "params": {"targets": "healthy_local_user", "cost": {"hp_max_pp": 10, "hp_min_flat": 1, "nonlethal": true}, "restore": {"mp_max_pp": 50}, "limit": "none"}, "effect": "探索时，健康队员用自身生命上限的 10% 换取魔力上限 50% 的魔力。生命代价向下取整，至少 1 点。喝完得至少剩 1 点生命，也得确实能回复魔力，否则什么都不扣。", "story": "瓶颈系着一条黑绳。守桥的术士曾连喝两口，撑完最后一道术后便伏在地上吐血；药师赶到，把剩下的瓶子全收进了自己的包里。"},
	"trail_spark_tea": {"name": "行火茶包", "type": "C", "price": 100, "source": "exploration_milestone", "hook": "retired", "params": {}, "effect": "已退出远征，可在商摊出售。", "story": "采茶人把味道最烈的一撮叶子另包起来，留给必须赶路、却愿意晚些再做精细活的人。"},
	"unfolding_map_leaf": {"name": "展途图叶", "type": "C", "price": 100, "source": "field_cache", "hook": "map_reveal_use", "params": {"mode": "terrain_and_public_nodes", "radius": 3, "center": "current_position", "limit": "none"}, "effect": "探索时使用，记下当前位置周围三圈内可以公开的地形和普通地点。已经全知道时不消耗。", "story": "地图师把一小片相邻道路藏在折页里，等旅人走到页边，再展开那处细心画过的接续。"},
	"cache_tracing_powder": {"name": "寻匣描粉", "type": "C", "price": 65, "source": "field_cache", "hook": "map_reveal_use", "params": {"mode": "nearest_unclaimed_public_cache_marker", "radius": 4, "tie": "node_id", "limit": "none"}, "effect": "探索时使用，在当前位置周围四圈内标出最近一个能公开、没标过也没领过的野外宝箱。找不到新箱子时不消耗。", "story": "木箱匠在库房里撒粉找漏风的裂缝，却先找到了偷粮人擦过的脚印。管仓的悬赏说要捉贼，他认出是欠饷的搬运工，便只补好了那道缝。"},
	"patient_recovery_oil": {"name": "慢养油膏", "type": "C", "price": 100, "source": "shop", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"hp_max_pp": 50}, "limit": "none"}, "effect": "探索时，健康队员使用后回复自身生命上限的 50%。没能实际回血时不消耗。", "story": "伤兵总想多抹一点，好赶在点名以前站起来。熬膏的老人就坐在床边盯着，说药是按伤处给的，不是按军官的脾气给的。"},
	"modest_trade_coupon": {"name": "小额货券", "type": "C", "price": 40, "source": "commission", "hook": "transaction_use", "params": {"channel": "shop_buy", "reduce_flat": 30, "limit": "none"}, "effect": "在商店确认买一件物品时，最多可省 30 灯铢。所有优惠加起来最多省原价的 25%，买价仍要高于卖价。买成且确实省了钱才用掉券。", "story": "杂货商缺零钱，把欠下的小额找零写成了货券。客人下次拿券回来，常又买走别的东西；商人从此不再急着把零钱凑齐。"},
	"fitting_labor_ticket": {"name": "整修工票", "type": "C", "price": 65, "source": "commission", "hook": "transaction_use", "params": {"channel": "enhancement_fee", "reduce_flat": 20, "limit": "none"}, "effect": "在安全探索时确认强化装备，可少花最多 20 灯铢。所有强化优惠加起来最多省原价的 25%。实际付了款也省了钱，才用掉票。", "story": "工票是铁匠打赌输给酒馆伙计的，凭它能抵一部分整修钱。伙计转手换了两顿饭，铁匠直到见到陌生人来兑票，才知道自己的手艺已经被卖了一回。"},
	"folded_route_string": {"name": "折线引路绳", "type": "C", "price": 40, "source": "exploration_milestone", "hook": "route_use", "params": {"scope": "current_map", "target": "selected_revealed_reachable_node", "cost": "steps", "limit": "none"}, "effect": "探索时选一个已发现且能到达的地点，记下已知路线中步数最少的走法。已有相同记录时不消耗。移动后旧记录就会过期。", "story": "领路人给认不得字的弟弟结了一条绳，每种绳结对应一处分岔。弟弟找到新住处后没舍得拆，又在末尾添了一个结，留给哥哥下次来看他。"},
	"passing_cup": {"name": "递饮杯", "type": "C", "price": 100, "source": "spirit_farewell", "hook": "resource_use", "params": {"targets": "selected_other_healthy_joined_same_cell", "cost": {"user_mp_flat": 20}, "restore": {"mp_flat": 30}, "limit": "none"}, "effect": "探索时，健康队员可花自己的 20 点魔力，给同一地块的另一名健康队员回复 30 点魔力。魔力不够或对方没能实际回复时，什么都不扣。", "story": "杯柄是行脚木匠特意接长的，能递到车厢最里面。有人笑它像勺子，等自己的腿受了伤挤在里面，便不再嫌了。"},
