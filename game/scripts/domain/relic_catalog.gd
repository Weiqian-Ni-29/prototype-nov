	"return_seam": {"name": "归队线轴", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "combat_heal", "params": {"on": "victory_after_self_hp_damage", "targets": "surviving_actor", "hp_max_pp": 5, "limit": "a_battle:1"}, "effect": "战斗胜利时，本战曾受敌方基础伤害造成 HP 损失且仍健康存活的参战成员各恢复自身 hp_max 5%；逃离、失败、未受伤和未上场成员无效。", "story": "医护员给每件归还的外衣补一针，不求补得好看，只让主人摸到那处线头时知道自己已经回来。"},
	"fallen_standard_tassel": {"name": "垂旗流苏", "type": "P", "price": 150, "source": "field_cache", "hook": "combat_shield", "params": {"on": "first_other_ally_defeated_by_enemy", "targets": "all_living_allied_participants", "hp_max_pp": 6, "limit": "q_battle:1"}, "effect": "本战首次有己方参战成员被敌方基础伤害击倒后，为其余仍健康存活的己方参战成员各加自身 hp_max 6% 护盾，全队每战一次；不保护已倒下者、不复活。", "story": "撤离的人从倒下的旗杆上剪走流苏，用来绑紧最后一辆载伤员的车。"},
	"narrow_margin": {"name": "窄边书签", "type": "P", "price": 100, "source": "shop", "hook": "combat_cost", "params": {"when": "self_hp_ratio_lte_25", "reduce_pp": 20, "min_flat": 1, "limit": "none"}, "effect": "成员在支付技能费用前 HP 不高于 hp_max 25% 时，普通技能正 MP 消耗减少 20%，向上取整且最低 1；不减少生命代价，也不自动治疗。", "story": "纸张最短缺的那一年，讲师把注释写进窄窄的页边，仍给学生留下了提问的位置。"},
	"impact_pad": {"name": "回震软垫", "type": "P", "price": 150, "source": "commission", "hook": "combat_shield", "params": {"on": "single_enemy_action_hp_loss_gt_20_max_pp", "hp_max_pp": 6, "limit": "a_battle:1"}, "effect": "同一敌方动作对成员造成的实际 HP 损失累计超过自身 hp_max 20% 后，若其仍存活，则动作结束时获得 hp_max 6% 护盾，每成员每战一次；不降低已结算伤害，致死不触发。", "story": "搬运石料的人把碎布缝进肩垫，重物落下时仍会疼，只是不再把人一下压垮。"},
	"familiar_knock": {"name": "识响门钉", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_damage_reduction", "params": {"when": "same_enemy_as_previous_damaging_action_before_self_action", "scope": "direct", "reduce_pp": 15, "limit": "none"}, "effect": "成员未执行自身计数行动期间，若再次被与上一伤害动作相同的敌人直接攻击，该新动作对其直接伤害减免 15%；不同敌人造成正量伤害则替换记忆，自身行动清空，多段不算重复动作。", "story": "住在狭巷的木匠能从门钉的震声分辨熟客，他为常来借工具的人留了一道更厚的门衬。"},
	"tender_gauze": {"name": "柔纱结", "type": "P", "price": 100, "source": "recruit:eve", "hook": "healing_modifier", "params": {"scope": "battle_received_hp_nonrelic", "when": "recipient_hp_ratio_lte_30", "bonus_pp": 20, "limit": "none"}, "effect": "战斗中成员在受治疗前 HP 不高于上限 30% 时，正常技能及普通道具对其 HP 治疗量 +20%；不作用于 MP、遗器治疗、满血空刷或复活。", "story": "纱结被仔细打在伤口之外，包扎的人说，照顾别人时连一个结的位置也值得多想一会儿。"},
	"unburdened_clasp": {"name": "空肩扣", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "combat_stat_modifier", "params": {"when": "self_shield_zero", "stat": "speed", "delta_pp": 8, "until": "condition_ends", "limit": "none"}, "effect": "成员没有护盾时速度 +8%；获得正量护盾立即失效，护盾归零重新生效，不主动清除护盾、不提前触发已排定行动。", "story": "信使卸下沉重的邮袋后仍戴着肩扣，以免忘记路上还有别人等着下一封信。"},
	"last_drop_cup": {"name": "底滴锡杯", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_stat_modifier", "params": {"when": "self_mp_ratio_lte_25", "stat": "defense", "delta_pp": 12, "until": "condition_ends", "limit": "none"}, "effect": "成员 MP 不高于 mp_max 25% 时防御 +12%，超过阈值立即撤销；不改变 MP 上限，不另外提供减伤层或恢复。", "story": "长途押运的伙计总把最后一口水留在锡杯底，用来润湿缠在掌心的布条。"},
	"rain_listening_pin": {"name": "听雨别针", "type": "P", "price": 65, "source": "field_cache", "hook": "combat_resource", "params": {"on": "rain_first_positive_basic_attack", "restore": {"mp_max_pp": 3}, "targets": "actor", "limit": "a_battle:1"}, "effect": "雨天战斗中，成员普通攻击实际造成伤害后恢复自身 mp_max 3% 的 MP，每成员每战成功一次；非雨天无效，多段只检查一次。", "story": "裁缝把别针别在窗帘上，听见针脚轻碰窗框，便知道该把晾着的布收进屋了。"},
	"banked_ember_box": {"name": "留炭盒", "type": "P", "price": 100, "source": "shop", "hook": "combat_resource", "params": {"on": "positive_fire_direct_damage_in_burning", "targets": "actor", "restore": {"mp_flat": 3}, "limit": "a_battle:1"}, "effect": "成员在燃烧场以正常火属性行动造成正量直接伤害后，回复自身 MP 3，每成员每战一次；必须实际回复才扣次数，不延长燃烧，不改变双方灼烧的8%/10时间单位节律。", "story": "炭工把未灭的炭埋进细灰，原想留给清晨开炉，也在盒盖上刻下了小心复燃的告诫。"},
	"rime_thimble": {"name": "凝霜顶针", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "combat_field", "params": {"on": "positive_ice_direct_damage", "from": "wet", "set": "frozen", "actions": 4, "limit": "q_battle:1"}, "effect": "己方正常冰属性直接伤害后，wet=true 且无冥河时添加或刷新冰面，持续四次后续行动，全队每战一次；双方各单位每冰面实例首次行动后承受一次既有 slow 排期。火命中融冰或到期时只移除冰面，保留底层湿润。", "story": "山村裁衣人把顶针放进冷水里降温，薄霜沿着金属边缘结起时，她便知道炉火该添了。"},
	"copper_rain_comb": {"name": "铜齿雨梳", "type": "P", "price": 150, "source": "field_cache", "hook": "combat_field", "params": {"on": "positive_lightning_direct_damage", "from": "wet", "set": "charged", "actions": 4, "limit": "q_battle:1"}, "effect": "己方正常雷属性直接伤害后，wet=true 且无冥河时添加或刷新导电，持续四次后续行动，全队每战一次；双方雷系环境桶额外 +0.10，仍受0.5..1.5上限，不产生额外场伤，结束保留湿润。", "story": "修屋顶的人把铜齿梳留给学徒，叮嘱雷雨来时先放下金属工具，再惦记没做完的活。"},
	"crossed_wind_chimes": {"name": "交风短铃", "type": "P", "price": 150, "source": "recruit:storm_caller", "hook": "combat_field", "params": {"on": "positive_wind_direct_damage", "from": ["empty", "wet"], "set": "wind_barrier", "actions": 4, "limit": "q_battle:1"}, "effect": "己方正常风属性直接伤害后，在空场或湿润且无冥河时添加或刷新风障，持续四次后续行动，全队每战一次；双方远程直接伤害乘0.90，自己的远射同样受影响。结束仅移除风障，不清除湿润。", "story": "两片短铃从不在同一方向摆动，挂铃的人说，学会听风也包括听见自己挡住的声音。"},
	"rootbound_bracelet": {"name": "盘根手环", "type": "P", "price": 150, "source": "spirit_farewell", "hook": "combat_field", "params": {"on": "guard", "from": ["empty", "wet"], "set": "root_cover", "actions": 4, "limit": "q_battle:1"}, "effect": "己方成员防御后，在空场或湿润且无冥河时添加或刷新根护，持续四次后续行动，全队每战一次；双方直接伤害乘0.95，正常火直接命中后移除。敌人也可受护，不附加回复，不清除底层湿润。", "story": "园丁用落下的细根编成手环，提醒搬进新院子的人留一片阴凉，也留一点给陌生人歇脚的地方。"},
	"field_water_sponge": {"name": "吸水海绵", "type": "P", "price": 100, "source": "commission", "hook": "combat_field", "params": {"on": "water_applies_new_wet_in_burning", "from": "wet_finite_after_transition", "extend_actions": 2, "max_actions": 6, "limit": "q_battle:1"}, "effect": "己方以带湿润效果的正常水技能有效命中，且行动开始时已有 burning、没有 wet，则在实际施加 wet 后提议将这次湿润延长 2 行动，最多 6 行动，全队每战成功一次；刷新已有湿润不触发。海绵不施加湿润，不影响燃烧，也不恢复资源。", "story": "灶台旁总挂着这块海绵。帮工会用它浸湿围裙和袖口，好从热气里把锅端下来。"},
	"dripping_spool": {"name": "滴线绕轴", "type": "P", "price": 100, "source": "shop", "hook": "combat_shield", "params": {"on": "positive_water_direct_damage_started_without_wet", "hp_max_pp": 5, "targets": "actor", "limit": "a_battle:1"}, "effect": "成员在行动开始没有wet的战场，以正常水属性行动造成正量直接伤害并自然形成湿润后，获得自身hp_max 5%的护盾，每成员每战一次；不额外造湿润，不从遗器次生伤害触发。", "story": "织工用湿线压住扬起的尘埃，绕轴上的水痕一圈叠一圈，像没有写完的工时簿。"},
	"conductive_needle": {"name": "引流针", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_cost", "params": {"when": "lightning_skill_in_wet", "reduce_flat": 2, "min_flat": 1, "limit": "a_battle:1"}, "effect": "成员在 wet=true 时合法施放普通雷属性技能，第一次实际减免的 MP 费用减少2，最低1，每成员每战一次；带导电或冰面但底层仍湿润时也成立，river 本身不自动算 wet，不退还已支付费用。", "story": "铜匠用细针试出水槽接缝的走向，确认流路之后，才肯把整块铜板压下去。"},
	"ice_anchor_button": {"name": "冰锚纽扣", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "combat_stat_modifier", "params": {"when": "field_frozen", "stat": "defense", "delta_pp": 20, "extra": {"speed_pp": -5}, "until": "field_changes", "limit": "none"}, "effect": "冰面存在时成员防御 +20%，但速度额外降低5%；它与冰面首次行动的一次 slow 排期分别结算，不抵消控制。冰面消失后两项立即撤销，不修改敌人属性或既有行动预约。", "story": "冰河旁的搬运工把重纽扣缝在外衣下摆，风吹不起来，走路却确实比旁人慢些。"},
	"grounding_heel": {"name": "泄电跟铁", "type": "P", "price": 100, "source": "shop", "hook": "combat_damage_reduction", "params": {"when": "field_charged_and_incoming_lightning", "scope": "direct", "reduce_pp": 20, "limit": "none"}, "effect": "导电状态存在时，成员承受的敌方雷属性直接伤害减少20%，与装备／遗器减伤桶合并，仍最多50%；不减少其他元素或灼烧，不取消湿润／导电的环境加成，不保护敌方。", "story": "修钟人给木梯包上这块跟铁，第一次试用前，仍先检查了脚下的水迹。"},
	"river_brace": {"name": "涉流腕撑", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_stat_modifier", "params": {"on": "guard_in_river", "stat": "defense", "delta_pp": 15, "until": "next_own_action_end_or_field_change", "limit": "none"}, "effect": "成员在冥河场防御后，防御属性 +15%，持续至其下一次计数行动结束或离开冥河场；再次防御仅刷新，不叠层，不修改基础防御动作减伤。", "story": "摆渡学徒靠腕撑握住湿滑的撑杆，师傅只教他站稳，没有许诺水流会因此变轻。"},
	"rain_route_tag": {"name": "雨路签", "type": "P", "price": 100, "source": "commission", "hook": "map_ap", "params": {"on": "paid_move_in_rain", "ap_flat": 1, "targets": "local_mover", "limit": "q_day:1"}, "effect": "雨天中本地健康成员成功移动且实际支付正量 AP 后，返还 AP 1、钳制上限；全队每游戏日最多成功一次，不降低账面移动费、不因引雨或读档重置。", "story": "山脚客栈把容易积水的路口写在小签上，旅人回来时，常会再补上一条更稳的走法。"},
	"mixed_soil_pouch": {"name": "三土囊", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "map_ap", "params": {"on": "third_distinct_destination_terrain_today", "ap_flat": 1, "targets": "local_mover", "limit": "a_day:1"}, "effect": "每成员当日实际付 AP 移动到 3 种不同的可通行地形后恢复自身 AP 1，每成员每日一次；按目的地真实 terrain_key 去重，同地形反复走不累计，不要求新增地形种类。", "story": "测路人从山坡、林边和石道各取一撮土，回程时凭指间的触感回想哪里最费脚力。"},
	"ash_filter_patch": {"name": "滤灰布章", "type": "P", "price": 100, "source": "recruit:ashhorn", "hook": "combat_damage_reduction", "params": {"when": "burning_tick", "scope": "burning_field_tick", "reduce_pp": 25, "limit": "none"}, "effect": "成员承受灼烧场每 10 时间轴刻度的 8% hp_max 基础场伤时，该场伤减免 25%，纳入统一减伤上限；不改灼烧频率、不消灭火场、不减少火属性直接伤害。", "story": "烧窑工把最厚的一层滤灰布剪成小章，送人前还仔细抖净了缝里的碎炭。"},
	"thaw_water_vial": {"name": "解冻水瓶", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "combat_resource", "params": {"on": "own_natural_fire_melts_frozen", "restore": {"energy_flat": 8}, "targets": "actor", "limit": "a_battle:1"}, "effect": "成员以正常火属性直接伤害实际融化冰冻场后获得能量 8，每成员每战一次；仅奖励基础行动触发的真实融冰，不能从遗器次生火伤或自然到期领取。", "story": "水瓶曾冻在门槛边，邻居用温布一点点化开瓶口，没有因为着急就把玻璃敲碎。"},
	"field_dial": {"name": "场息圆盘", "type": "P", "price": 65, "source": "shop", "hook": "combat_info", "params": {"view": "field_remaining_actions_and_next_burning_tick", "limit": "none"}, "effect": "共鸣时战斗界面显示当前共享场名称、有限场剩余全局行动数、下一次灼烧距离多少时间轴刻度及是否影响双方；无限场明确标记，不预测未发动技能。", "story": "旧工坊用圆盘记录炉温变化，最后一位看炉人把容易误读的刻度重新描了一遍。"},
	"waterline_thread": {"name": "水线丝", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_heal", "params": {"on": "positive_water_direct_damage_started_in_wet", "targets": "actor", "hp_max_pp": 3, "limit": "a_battle:2"}, "effect": "成员在动作开始时 wet=true，以正常水属性行动造成正量直接伤害后回复自身 hp_max 3%，每成员每战最多2次；多段／多目标只算一个动作。带导电或冰面仍读取底层 wet；仅有 river 不算湿润。", "story": "渔网修补者用一根颜色浅些的丝标出水线，网收回来时，总能先找到最容易磨损的那一段。"},
	"unpacking_mat": {"name": "开箱垫布", "type": "P", "price": 65, "source": "field_cache", "hook": "map_ap", "params": {"on": "field_cache_first_claim_positive_loot", "ap_flat": 1, "targets": "healthy_local_claimant", "limit": "run_object:1"}, "effect": "健康本地领取者首次成功领取一个野外宝箱的正量物品或灯铢后恢复自身 AP 1；每局每个 cache_id 一次，已开空箱、界面重开、奖励补发不触发。", "story": "搬家的人把杂物摊在垫布上，一眼就能找出该先装进包里的东西，少走许多回头路。"},
	"survey_tally": {"name": "踏查筹", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "map_info", "params": {"view": "current_region_visible_milestone_progress", "limit": "none"}, "effect": "探索面板显示当前区域已公开的里程碑阈值、真实进度和已揭示可达但未访问的节点数量；不把隐藏剧情节点算成可定位目标，不赠进度或奖励。", "story": "绘图人每走过一处路口便挪一根筹，旁人能看到他的进度，也能看到他尚未走过的空白。"},
	"rest_step_counter": {"name": "歇脚计步扣", "type": "P", "price": 100, "source": "shop", "hook": "rest_bonus", "params": {"restore": {"ap_flat": 1}, "targets": "healthy_rest_participants_with_positive_base_hp_or_mp", "require_positive": "base_hp_or_mp", "limit": "q_day:1"}, "effect": "在恢复节点实际恢复生命或魔力的健康队员，各回复 1 点精力。全队每天最多成功触发一次，异地队员和没有实际恢复的队员不触发。", "story": "客栈木工在长凳边钉了小扣，提醒赶路人坐下时把鞋带重新系好，再起身走下一段。"},
	"season_patchwork": {"name": "四季拼毯", "type": "P", "price": 100, "source": "recruit:seasons", "hook": "rest_bonus", "params": {"restore": {"hp_max_pp": 10}, "targets": "healthy_rest_participants_with_positive_base_hp", "require_positive": "base_hp", "limit": "q_day:1"}, "effect": "真实休息已实际恢复 HP 的健康参与成员，各追加恢复自身 hp_max 10%；全队每日最多一次有正量追加的结算，只作用于实际休息者，不复活、不对满血空休发奖励。", "story": "四块旧布来自不同季节修补过的衣物，缝成一张毯子后，谁也不再追问哪一块更暖。"},
	"shared_kettle_lid": {"name": "分茶壶盖", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "rest_bonus", "params": {"restore": {"mp_max_pp": 12}, "targets": "lowest_mp_ratio_positive_base_mp_rest_participant", "require_positive": "base_mp", "tie": "actor_id", "limit": "q_day:1"}, "effect": "真实休息后，从本次基础 MP 实际恢复过且仍缺 MP 的健康参与者中，选 MP 比例最低者额外恢复自身 mp_max 12%；同率按 actor_id，每日全队一次，不将远处未休息者纳入。", "story": "茶馆主人用壶盖分辨哪杯茶还没续过，最后一壶总先倒给说得最少、看起来最累的人。"},
	"market_window": {"name": "市窗木框", "type": "P", "price": 65, "source": "shop", "hook": "map_info", "params": {"view": "revealed_shop_existing_stock_and_prices", "limit": "none"}, "effect": "在地图上远程查看已发现商店当前已经生成的库存与现行报价；不提前生成新货、不刷新商店随机、不允许远程购买或绕过到店条件。", "story": "行商把货单挂在木框里，即使摊位暂时无人照看，来客也不用白等一场。"},
	"caution_compass": {"name": "慎行罗盘", "type": "P", "price": 100, "source": "field_cache", "hook": "map_info", "params": {"view": "nearest_public_elite_direction", "radius": 3, "limit": "none"}, "effect": "显示当前位置拓扑 3 圈内最近的可公开精英战斗节点的方向与距离，距离相同按 node_id；不揭示阵容、隐藏剧情节点或路线通行性，不移动玩家。", "story": "领路人把危险岔口记在罗盘背面，并在最醒目的地方写下：知道在哪里，不等于必须前往。"},
	"honest_ledger": {"name": "实记账簿", "type": "P", "price": 65, "source": "commission", "hook": "map_info", "params": {"view": "accepted_commission_actual_requirements_and_claim_state", "limit": "none"}, "effect": "委托界面并列显示已接委托的真实目标进度、提交条件与已领取标记；不补全未知剧情，不改变完成状态，也不因选择“已完成”的对话获得任何增益。", "story": "账房把听来的消息和亲手验过的货分成两栏，宁可留下空格，也不把猜测写成结清。"},
	"terrain_caliper": {"name": "路费卡尺", "type": "P", "price": 65, "source": "exploration_milestone", "hook": "map_info", "params": {"view": "revealed_move_cost_breakdown", "radius": 2, "limit": "none"}, "effect": "在当前位置两圈内已揭示的可通行边上，显示该本地成员的地形基础 AP 费用、共鸣/装备减免和最终最低 1 的费用；不额外开视野、不付款、不执行移动。", "story": "修路的老师傅用卡尺量石缝，也量每一段坡给行人添了多少负担。"},
	"cloud_almanac": {"name": "云迹小历", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "weather_forecast", "params": {"days": 2, "weather_partition": "rain_or_nonrain", "limit": "none"}, "effect": "显示未来两日正常天气的“雨/非雨”预测；在天气 RNG 的克隆状态上推演，不推进正式随机序列。天气规则或强制天气发生变更后重算，不承诺其他天气细类。", "story": "田边记雨的人把猜错的日子也留在小历上，后来的读者因此更愿意相信那些仔细的注记。"},
	"uphill_kneepad": {"name": "上坡膝垫", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_shield", "params": {"arm": "local_paid_move_cost_gte_3", "on": "next_battle_first_deployment_same_day", "hp_max_pp": 8, "targets": "armed_actor", "expires": "day_end_or_next_battle_end_or_unattune", "limit": "a_day:1"}, "effect": "成员实际支付至少 3 AP 完成一次探索移动后，预备当天下一场战斗首次上场的自身 hp_max 8% 护盾，每成员每天最多成功一次；预备不叠层，解除共鸣、当天结束或下一战结束清除，不能回溯旧移动。解除共鸣清除预备但不清除当天已用次数，重新共鸣后必须有新的合格移动才能再次预备。", "story": "采药人把膝垫磨出了斜斜的纹路，爬上坡顶时，他总先拍掉泥土再继续赶路。"},
	"milestone_waterbag": {"name": "路碑水囊", "type": "P", "price": 150, "source": "exploration_milestone", "hook": "map_resource", "params": {"on": "exploration_milestone_first_positive_reward_claim", "targets": "all_healthy_joined_global", "restore": {"mp_max_pp": 15}, "limit": "run_object:1"}, "effect": "一个真实探索里程碑首次成功领取正量基础奖励后，为所有健康已入队成员（明确跨地图全局）各恢复 mp_max 15%；每 milestone_id 每局一次，不能重领或靠空提交触发。", "story": "商队抵达路碑时会把水囊传一圈，哪怕有人走在队尾，也不会漏掉他的那一口。"},
	"bargaining_counter": {"name": "议价铜筹", "type": "P", "price": 150, "source": "shop", "hook": "economy_discount", "params": {"channel": "shop_buy", "reduce_pp": 10, "when": "all_valid_purchases", "limit": "none"}, "effect": "全队在商店有效购买时基础买价减少 10%，与装备/其他购买优惠合计最多 25%，且实际买价必须高于最终卖价；不影响奖励、不产生返现。", "story": "老商人用铜筹一枚枚谈妥价格，筹码落定后，他便不会再偷偷拨回自己那边。"},
	"workshop_gauge": {"name": "工坊规尺", "type": "P", "price": 150, "source": "commission", "hook": "economy_discount", "params": {"channel": "enhancement_fee", "reduce_pp": 15, "when": "all_valid_enhancements", "limit": "none"}, "effect": "全队合法装备强化的灯铢费用减少 15%，与其他强化优惠合计最多 25%；不减少材料、不改变强化效果或概率，原免费强化不变成发钱。", "story": "工坊把常用尺寸刻在规尺上，少量返工省下的工钱，被师傅如数记回了客人的账。"},
	"fair_weight_seal": {"name": "公秤封签", "type": "P", "price": 150, "source": "spirit_farewell", "hook": "economy_sale", "params": {"bonus_pp": 15, "limit": "none"}, "effect": "全队有效出售商品的基础卖价提高 15%，与其他卖价增益合计最多 25%；仍受任何实际买价严格高于卖价的全局约束，赠金不再次触发奖励钩子。", "story": "集市上的秤每次校准后都会封上一张签，摊主和买家都能看见封口是否被揭开。"},
	"commission_carbon": {"name": "委托复写纸", "type": "P", "price": 100, "source": "commission", "hook": "economy_reward", "params": {"source": "commission", "bonus_pp": 15, "limit": "run_object:1"}, "effect": "真实委托首次领取奖励且基础灯铢大于零时，仅该基础灯铢增加 15%；每 reward_claim_id 每局一次，重复提交、退款、售卖及虚假完成选项均无效。", "story": "跑腿人留下一份淡淡的复写底稿，让忙忘了的人仍有凭据核对约定的报酬。"},
	"farewell_receipt": {"name": "送别留据", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "map_resource", "params": {"source": "spirit_farewell", "targets": "healthy_local_operator", "restore": {"mp_flat": 6}, "limit": "q_day:1"}, "effect": "本地健康操作者真实完成亡灵送别后回复自身 MP 6，每天全队最多一次；必须实际回复且该送别 source 尚未领取此效果。调查、回顾、个人分支均不触发，不凭无灯铢的基础奖励额外变出钱。", "story": "一位家属把需要交代的事逐项写在纸上，料理送别的人因此能歇一歇，不必反复绷紧心神确认遗漏。"},
	"survey_bonus_stamp": {"name": "勘路奖印", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "economy_discount", "params": {"channel": "shop_buy", "when": "visited_count_gte_60", "reduce_pp": 10, "limit": "q_day:1"}, "effect": "本局实际到访不同地块达到60格后，每天第一笔真正享受优惠的商店购买减价10%；与所有购买优惠合计最多25%，遵守最低买价高于最高卖价。只揭雾不计格数，售出／退款不触发。", "story": "修路公会在核验过的勘路记录上加盖奖印，沿路商户凭印让一点利，认可的是人真正走过的路。"},
	"first_fit_pattern": {"name": "初配纸样", "type": "P", "price": 100, "source": "field_cache", "hook": "economy_discount", "params": {"channel": "enhancement_fee", "reduce_pp": 10, "when": "first_discounted_enhancement_per_equipment_instance", "limit": "run_object:1"}, "effect": "每局每个装备实例第一次实际享受本遗器优惠的合法强化，灯铢费用再减基础费用 10%；与所有强化优惠合计最多 25%，仅实际减免且支付成功才记 equipment_instance_id，转卖买回不重置。", "story": "老裁工把初次量体的纸样交给客人，后来换了哪间铺子，都不用重新猜肩膀的宽窄。"},
	"price_pair_slip": {"name": "双价对照签", "type": "P", "price": 65, "source": "shop", "hook": "map_info", "params": {"view": "current_shop_final_buy_sell_and_discount_floor", "limit": "none"}, "effect": "在已到达商店的交易页，对每件已有报价商品同时显示当前最终买价、卖价和因严格价差下限被截断的优惠；不改变价格、不远程交易，也不生成未上架商品。", "story": "掌柜把进出两栏价格写在同一张签上，客人不必靠试买试卖才能发现其中的差额。"},
	"breath_reserve": {"name": "蓄息口哨", "type": "P", "price": 100, "source": "commission", "hook": "combat_resource", "params": {"arm": "normal_skill_positive_mp_payment", "on": "next_guard", "restore": {"energy_flat": 5}, "targets": "actor", "limit": "a_battle:1"}, "effect": "成员正常技能实际支付正量 MP 后预备一次回息；其下一次防御完成时获得能量 5，每成员每战成功最多一次。防御总会清除本次预备，满能量不耗总次数但须重新付 MP 才能再预备。", "story": "山道上的领唱人把最长的一口气留给停步后的短哨，让跟在后面的队伍知道何时可以歇下。"},
	"tracking_notch": {"name": "追纹刻片", "type": "P", "price": 100, "source": "field_cache", "hook": "combat_damage_bonus", "params": {"when": "consecutive_basic_attack_same_recorded_target", "bonus_pp": 12, "record_target": "lowest_id_positive_damage_target", "limit": "none"}, "effect": "成员一次普攻造成正量伤害后记录其中 enemy_id 最小的目标；若下一次计数行动仍为普攻且伤及该目标，仅对它伤害 +12%，随后按本次结果更新。其他行动清记录，多段不能自行连锁。", "story": "木刻师沿着同一道纹路反复推刀，每次只削去薄薄一层，换纹路前则一定先把刀提起。"},
	"ready_sandal_loop": {"name": "整履环", "type": "P", "price": 100, "source": "exploration_milestone", "hook": "combat_action_delay", "params": {"when": "first_deployment", "phase": "initial_wait", "reduce_pp": 15, "limit": "a_battle:1"}, "effect": "每成员每战首次上场时，初始等待延迟减少 15%，不低于现有行动下限；已立即可行动者不额外获行动，换下再上不重触发，不影响后续动作延迟。", "story": "领队出发前逐个检查伙伴的鞋环，花不了多少时间，却很少再有人刚走几步就掉队。"},
	"closing_chime": {"name": "止战小磬", "type": "P", "price": 100, "source": "spirit_farewell", "hook": "combat_resource", "params": {"on": "self_direct_damage_first_defeat_of_enemy", "restore": {"mp_max_pp": 6}, "targets": "actor", "limit": "a_battle:1"}, "effect": "成员以普通攻击、技能或终结技直接造成一名敌人本战首次被击倒后，恢复自身 mp_max 6%，每成员每战一次；场伤、遗器伤害、重复倒地与他人击倒不触发。", "story": "小磬原用于通知诊棚争斗已经停下，敲响它的人总希望随后听见的是放下器械的声音。"},
	"sheltered_stitch": {"name": "庇身缝线", "type": "P", "price": 100, "source": "shop", "hook": "combat_heal", "params": {"arm": "guard_then_enemy_direct_hp_loss", "on": "next_own_action_start", "targets": "surviving_actor", "hp_max_pp": 5, "limit": "a_battle:1"}, "effect": "成员防御后至下一次自身计数行动前，若仍被敌方直接伤害扣过 HP，则在该下一行动开始时恢复自身 hp_max 5%，每成员每战一次；必须仍健康存活，纯护盾受损无效。", "story": "修篷人把最牢的一针藏在折边里，风雨过去后，人们才发现那处不起眼的缝线一直没有松。"},
	"witness_slate": {"name": "亲历石板", "type": "P", "price": 65, "source": "commission", "hook": "combat_info", "params": {"view": "observed_enemy_action_records_this_run", "limit": "none"}, "effect": "可查本局亲眼见过的敌方已公开行动记录：公开技能名、元素、目标、实际 HP/护盾损失与当时场；没有观察记录则留空，不展示未知技能、未来阶段、隐藏身份或虚构弱点。", "story": "随行学者把听说的传闻另写在纸上，只有亲眼见过的经过，才值得刻进这块沉重的石板。"},
	"clean_bandage_roll": {"name": "净布绷带卷", "type": "C", "price": 40, "source": "shop", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"hp_max_pp": 30}, "limit": "none"}, "effect": "探索态使用，仅为健康本地使用者恢复自身 hp_max 30% 的 HP；不解除伤病、不复活，满 HP 或舍入后无恢复不消耗。", "story": "织坊把最内层的净布单独卷好，拆开封线的人可以放心把它贴近擦伤的皮肤。"},
	"mint_distillate": {"name": "薄荷澄露", "type": "C", "price": 40, "source": "field_cache", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"mp_max_pp": 30}, "limit": "none"}, "effect": "探索态使用，仅恢复健康本地使用者自身 mp_max 30% 的 MP；不恢复 HP、AP 或能量，满 MP 不消耗。", "story": "配药学徒把第一瓶澄清的薄荷露放在窗边，等泡沫散尽才肯贴上自己的标签。"},
	"pressed_travel_ration": {"name": "压实路粮", "type": "C", "price": 65, "source": "shop", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"ap_flat": 3}, "limit": "none"}, "effect": "探索态使用，仅恢复健康本地使用者 AP 3，钳制 ap_max；不跳过移动费用、不替其他成员恢复，满 AP 不消耗。", "story": "磨坊把碎麦压得紧实，赶路的人掰下一小块，也能在手心里稳稳握住。"},
	"balanced_broth_jar": {"name": "调和汤罐", "type": "C", "price": 65, "source": "spirit_farewell", "hook": "resource_use", "params": {"targets": "healthy_local_user", "restore": {"hp_max_pp": 15, "mp_max_pp": 15}, "limit": "none"}, "effect": "探索态使用，同时为健康本地使用者恢复 hp_max 15% 的 HP 和 mp_max 15% 的 MP，分别钳制；至少一项实际恢复才消耗一份，不按两项消耗两份。", "story": "食堂把温和的药草和剩下的好米煮在一起，留给既受了伤又忙得忘记休息的人。"},
	"bitter_exchange_vial": {"name": "苦酿换息瓶", "type": "C", "price": 100, "source": "commission", "hook": "resource_use", "params": {"targets": "healthy_local_user", "cost": {"hp_max_pp": 10, "hp_min_flat": 1, "nonlethal": true}, "restore": {"mp_max_pp": 50}, "limit": "none"}, "effect": "探索态使用，健康本地使用者支付自身 hp_max 10% 的 HP（向下取整、至少 1），恢复 mp_max 50% 的 MP；付款后须至少剩 1 HP，且 MP 必须有实际恢复，否则不扣 HP、不耗瓶。", "story": "药师在瓶颈扎了苦色的绳，提醒每位取用者：这不是白得的精神，也不能拿最后一口气交换。"},
