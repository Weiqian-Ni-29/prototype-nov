extends RefCounted

const WORLD = "维洛丹的人们知道四位神明。战神卡德兰掌管疯狂与纷争。四季之神梅文娜掌管春夏秋冬。大地之神多兰克能引发地震和火山喷发。天空神莱文索能唤来雷电和狂风。\n\n诸神开战以后，灾难落到了地上。亡者即使被安葬，魂魄也可能滞留，困住道路和水源。活人为了粮食、土地与旧仇继续争斗，曾约束诸方的旧秩序已经破碎。有人留下守家，有人逃往异乡。"

const VILLAGES = {
	"plains": ["河边村庄", "human", "前些天来了些逃难的人。对岸桥还在，可那边一直有人打仗。村里多熬了几锅粥，能让大家先吃上一顿。"],
	"forest": ["林间村庄", "elf", "原先沿着林子里的小路，半天就能到邻村。现在我们在岔路口挂了白布，提醒行人绕过出事的地方。"],
	"mountain": ["山间村庄", "dwarf", "地震把往城邦去的石桥震断了。我们搭了条小路，只够人走。工坊这几天忙着打钉子、做拐杖，剑反倒少打了。"],
	"desert": ["沙地村庄", "human", "井还出水，村里就把水分给过路的人。昨天来了一家子，走了三天才到这里。南面的商队已经很久没来了。"],
	"swamp": ["水边村庄", "elf", "从前沿着灯走就能过水。近来夜里有些灯会把人领进深水，我们把还安全的木道重新标了出来。"],
}

static func village(terrain: String) -> Array:
	return VILLAGES.get(terrain, VILLAGES.plains)

static func dialogue(terrain: String) -> Array:
	var local = village(terrain)
	return [
		["村民", "你醒了？先别急着坐起来。昨天我们在村外发现你，你怎么叫都没反应。来，喝点水。你还记得自己叫什么，或者是从哪里来的吗？"],
		["旅人", "一点也想不起来。你们发现我的时候，附近也在打仗吗？"],
		["村民", "村里还算平安。外面就难说了。诸神打起来以后，有的地方年年受灾，几个原本做生意的城镇也打起了仗。"],
		["村民", local[2] + "\n\n你要是再歇几天，床给你留着。"],
		["旅人", "谢谢。我不知道自己能做到多少，但想让这场战争停下来。先去看看那些断路和等药的人吧。你们救了我，我也想接住别人的求助。"],
		["村民", "那就把这包东西带上。里面有疗伤药、澄露和干粮。短刃也拿去，走野路的时候用得着。路上遇到说得上话的人，就结伴走一程。"],
		["村民", "我送你到村口。愿你一路平安。要是路过这里，记得回来喝口水。"],
	]
