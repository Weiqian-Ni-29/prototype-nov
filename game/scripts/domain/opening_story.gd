extends RefCounted

const WORLD = "维洛丹的人们原本会赶着车去邻村换粮。如今城门早早关上，路口站着征兵的人。有人拿出家里最后一袋麦子求神，有人磨好刀，等着去抢别人的粮仓。\n\n更让人害怕的是，有些人明明已经下葬，夜里却又走回了家。四座大神殿的钟接连响过，亡者还是没有离开。诸神各有各的争斗，地上的人只好自己找活路。"

const VILLAGES = {
	"plains": ["河边村庄", "human", "前些天来了不少逃难的人。桥还好好的，可对岸一直在打仗。村里多熬了几锅粥，好歹能让大家吃上一顿。"],
	"forest": ["林间村庄", "elf", "以前走林子里的小路，半天就能到隔壁村。现在有几段路走不得了。你要进林子，看到岔路口挂了白布，就绕开那条路。"],
	"mountain": ["山间村庄", "dwarf", "地震把去城邦的石桥震断了。我们另外修了条小路，人能走，车过不去。这几天工坊都在忙着打钉子、做拐杖，剑倒是没打几把。"],
	"desert": ["沙地村庄", "human", "我们这口井还有水，路过的人渴了就来打。昨天有一家人走了三天才到这儿。南边的商队倒是好久没见了。"],
	"swamp": ["水边村庄", "elf", "以前顺着灯走就能过水。最近有些灯看着像是指路的，跟过去却会掉进深水里。我们给还能走的木栈道重新做了记号。"],
}

static func village(terrain: String) -> Array:
	return VILLAGES.get(terrain, VILLAGES.plains)

static func dialogue(terrain: String) -> Array:
	var local = village(terrain)
	return [
		["村民", "你醒了？先别急着起来。昨天我们在村外找到你，叫了你好几声，你都没应。来，喝口水。还记得你叫什么吗？从哪儿来的？"],
		["旅人", "一点也想不起来。你们找到我的时候，这附近也在打仗吗？"],
		["村民", "村里还算太平，外头就难说了。有个地方求神保住粮食，粮仓倒是没事，隔壁村还没收的庄稼却全冻坏了。我们谁也没见过神。只知道以前互相做买卖的几个镇子，现在也打起来了。"],
		["村民", local[2] + "\n\n你要是还想歇几天，床给你留着。"],
		["旅人", "谢谢你们救了我。我也想帮帮其他人。先到附近看看吧，说不定还有人受了伤，手头又没药。也顺便打听打听，有没有人见过我。"],
		["村民", "那就把这包东西带上。里头有疗伤药、澄露和干粮。短刃也拿着，走小路用得上。要是路上遇到顺路的人，结个伴也好。"],
		["村民", "走，我送你到村口。一路平安啊。下次路过这儿，记得进来喝口水。"],
	]
