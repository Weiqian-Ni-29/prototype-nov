		"personal_b": {"label": "我要告诉你，是哪个将军让战船挂上求救的白布，混在撤离的人里渡河。", "response": "他下一次升起自己的战旗，我会认得那面旗。至于今夜的船，你们自己挑时辰。", "ending": "莱文索记住了借白布抢渡的将领，给他的下一次扬旗留下了神罚。幸存者没求到静风，只能继续等河上的风自己停下。"},
		"pending": "收殓的人仍拿着刻过名字的船板。谁都记得风曾停过，也记得白布未能让它再停一次。",
	},
	"snowforge": {
		"title": "砧雪 · 交出武器的是谁",
		"text": "城邦肯赦免我，只要我说是城主让我把武器交出去的。那晚跟我一起打开军械库、把兵器交出去的几个人还在城里。我揭穿这封信，他们也可能被拖出来。你觉得我先找谁说？",
		"personal_a": {"label": "我不会替城主改口。我想先把实话交上去，只写你的名字。", "response": "命令是我下的。其他人的名字要他们自己说。", "ending": "砧雪准备带着具名证词面对城邦。她拒绝借城主的名义洗脱自己，也准备先争取普通士兵能安全说话。"},
		"personal_b": {"label": "我想先不接城邦的赦免。拿着这封赦免书，去问问当年跟你一起开军械库的士兵。", "response": "我先问问他们。承认是我下的令会连累谁，跟城主当面对质又会连累谁，都说清楚了再决定。", "ending": "砧雪搁置了赦免机会，决定先找当年开库的人。旧城仍称她弃城，她愿意多背一阵这个罪名。"},
		"pending": "砧雪还没接下城主的赦免书。她知道有些旧同袍已经成家，未必愿意再被叫回那座军械库。",
	},
}

var run: RefCounted

func _init(expedition: RefCounted) -> void:
	run = expedition

func _choice(id: String, label: String) -> Dictionary:
	return {"id": id, "text": label, "enabled": true, "reason": "", "spoken": true}

func encounter_intro(visitor: String, subject: String) -> Dictionary:
	var member = run.actor(visitor)
	var person = run.actor(subject)
	if member.is_empty() or person.is_empty() or not BACKGROUNDS.has(subject) or not run.data.story.has(subject):
		return {"ok": false, "message": "没有可以交谈的对象。", "beats": []}
	if not member.joined or member.hp <= 0 or subject == visitor or person.position != member.position or not run.data.tiles.has(person.position):
		return {"ok": false, "message": "要交谈，先让能行动的队员走到对方身边。", "beats": []}
	if not run.data.tiles[person.position].enemies.is_empty():
		return {"ok": false, "message": "这里还不安全。先把敌人赶走，再和对方交谈。", "beats": []}
	return {"ok": true, "beats": []}

func _personal_choice(subject: String) -> String:
	return run.data.story[subject].get("personal_choice", "")

func _recorded_personal_quest(subject: String, chosen: String) -> Dictionary:
	if chosen.begins_with("personal_"):
		return LegacyOutcomes.OUTCOMES[subject]
	if chosen.begins_with("war_"):
		return LegacyOutcomes.PREVIEW_OUTCOMES.get(subject, PERSONAL_QUESTS[subject])
	if chosen.begins_with("war2_"):
		return LegacyOutcomes.WAR_OUTCOMES.get(subject, PERSONAL_QUESTS[subject])
	return PERSONAL_QUESTS[subject]

func _personal_outcome(subject: String, chosen: String) -> Dictionary:
	return _recorded_personal_quest(subject, chosen)["personal_" + chosen.right(1)]

func _personal_speech(subject: String, chosen: String) -> String:
	var response: String = _personal_outcome(subject, chosen).response
	if not response.contains("「"):
		return response
	# Historical outcomes interleave the actor's lines with descriptions of their gestures.
	var lines = PackedStringArray()
	for passage in response.split("「").slice(1):
		var line = passage.get_slice("」", 0)
		if line.ends_with("。") or line.ends_with("？") or line.ends_with("！"):
			lines.append(line)
	return "\n\n".join(lines)

func _personal_context(visitor: String, subject: String) -> Dictionary:
	var intro = encounter_intro(visitor, subject)
	if not intro.ok:
		return intro
	var person = run.actor(subject)
	if not PERSONAL_QUESTS.has(subject) or not person.joined or person.hp <= 0:
		return {"ok": false, "message": "这件事要等对方入队后再谈。两个人都得在场，也都得能行动。"}
	if run.data.status != "exploring" or not run.data.pending_battle.is_empty():
		return {"ok": false, "message": "等眼前的战斗打完、继续远征时，再来谈这件事。"}
	return {"ok": true}

func personal_quest(visitor: String, subject: String) -> Dictionary:
	var context = _personal_context(visitor, subject)
	if not context.ok:
		return context
	var quest: Dictionary = PERSONAL_QUESTS[subject]
	var chosen = _personal_choice(subject)
	if not chosen.is_empty():
		var title: String = _recorded_personal_quest(subject, chosen).title
		return {"ok": true, "title": title, "text": _personal_speech(subject, chosen), "options": [_choice("leave", "我记住了，咱们回头再聊。")], "pose": "friendly"}
	return {"ok": true, "title": quest.title, "text": quest.text, "options": [_choice("personal_a", quest.personal_a.label), _choice("personal_b", quest.personal_b.label), _choice("leave", "让我再想想，今天先别定下来。")], "pose": "serious"}

func _choose_personal(visitor: String, subject: String, option_id: String) -> Dictionary:
	if option_id not in ["personal_a", "personal_b"]:
		return {"ok": false, "message": "这里没有这个选项。"}
	var context = _personal_context(visitor, subject)
	if not context.ok:
		return context
	var chosen = _personal_choice(subject)
	if not chosen.is_empty():
		return {"ok": false, "message": "这件事已经定了。", "response": _personal_outcome(subject, chosen).response}
	var prefix := "god_" if Catalog.COMPANIONS[subject].race == "神" else "war2_"
	run.data.story[subject]["personal_choice"] = prefix + option_id.trim_prefix("personal_")
	return {"ok": true, "response": PERSONAL_QUESTS[subject][option_id].response}

func dialogue(visitor: String, subject: String) -> Dictionary:
	var intro = encounter_intro(visitor, subject)
	if not intro.ok:
		return intro
	var person = run.actor(subject)
	run.data.story[subject].met = true
	var identity: String = person.get("race", "旅人")
	if Catalog.COMPANIONS[subject].race == "神":
		identity = Catalog.COMPANIONS[subject].title + "的化身"
	var title = "%s · %s" % [person.name, identity]
	var speaker: String = person.name
	var body: String = BACKGROUNDS[subject] + "\n\n" + COMPANION_LINES[subject]
	var node = run.node_at(person.position)
	var choices: Array = []
	if person.hp <= 0:
		speaker = run.actor(visitor).name
		body = "还有呼吸。伤得这么重，得先止血。"
		choices.append(_choice("rescue", "我来找药，你撑住。"))
	elif person.joined:
		body = CHARACTER_BEHAVIOR[subject][2]
		if _personal_choice(subject).is_empty() and _personal_context(visitor, subject).ok:
			choices.append(_choice("quest", "我接下来还要往前走，你有什么打算？"))
	else:
		choices.append(_choice("join", "我想请你跟我一起上路。"))
		if not node.result.is_empty():
			choices.append(_choice("discuss", "我想听听你怎么看这里发生的事。"))
		if subject in ["granite", "ashhorn", "oathguard", "highdrake", "siltguard", "snowforge"] and not run.data.story[subject].get("duel", false) and run.actor(visitor).ap >= Catalog.BATTLE_AP:
			choices.append(_choice("duel", "我想跟你试几招，看看彼此的本事。"))
	var chosen = _personal_choice(subject)
	if person.joined and not chosen.is_empty():
		body += "\n\n" + _personal_speech(subject, chosen)
	if visitor == "hero" and person.hp > 0 and HERO_LINES.has(subject):
		body += "\n\n" + HERO_LINES[subject]
	choices.append(_choice("leave", "我先去看看路，回头再聊。" if person.joined else "那就聊到这儿吧，我先走了。"))
	var pose = "friendly" if person.joined or not node.result.is_empty() else "serious" if node.get("kind") == "haunt" or person.hp <= 0 else ""
	return {"ok": true, "title": title, "speaker": speaker, "text": body, "options": choices, "pose": pose}

func choose(visitor: String, subject: String, option_id: String) -> Dictionary:
	if option_id.begins_with("personal_"):
		return _choose_personal(visitor, subject, option_id)
	var d = dialogue(visitor, subject)
	if not d.ok:
		return d
	if not d.options.any(func(option): return option.id == option_id):
		return {"ok": false, "message": "现在无法这样做。"}
	match option_id:
		"quest":
			return {"ok": true, "quest": true}
		"join":
			var result = run.join_companion(subject, visitor)
			if result.ok:
				result.response = CHARACTER_BEHAVIOR[subject][1]
				run.record_story_progress(run.actor(visitor).position, false)
			return result
		"duel":
			var cell: String = run.actor(visitor).position
			run.data.story[subject].duel = true
			run.data.pending_battle = {"position": cell, "origin": cell, "npc": subject, "ambush": false, "movers": []}
			return {"ok": true, "battle": true}
		"discuss":
			return {"ok": true, "response": CHARACTER_BEHAVIOR[subject][3]}
		"rescue":
			return {"ok": true, "rescue": true}
	return {"ok": true, "close": true}

func main_ending() -> Dictionary:
	if run.data.status == "won":
		return {"title": "终于可以告别", "text": "卡德兰倒下了。当初他毁了伊文洛的身体，见亡魂再也没人带走，以为死神也彻底消失了。伊文洛那时自己也不知道，他还能重新有一副身体。那些已经死去的人，仍要走他们自己的路。\n\n现在，伊文洛知道那股让碎石浮起来、让脚步变轻的力量是怎么回事了。那是他用来给亡魂引路的重力。他也收回了冥河。河水属于冥界，能冲走碰到的一切，连同行的人也得离它远一点。\n\n这些年，死去的人留在世上，活着的人又为了水、粮食和旧仇打了起来。少了死神，再没人能拦住越打越凶的诸神。如今伊文洛回来了，终于能兑现一路上说过的话，把找不到路的亡者送回去。\n\n诸神停了手。活着的人还得修房子、补路、找失散的人。打了这么久，谁也没法替他们说一句‘这事就算了’。\n\n伊文洛想起村里的那包药。那时候，村民连他叫什么都不知道，也还是把药给了他。他想回去道个谢，再告诉大家，仗已经打完了。以后路上碰到缺药的人，他也愿意停下来帮一把。"}
	return {"title": "这次没能走到最后", "text": run.data.flags.get("failure_reason", "远征在这里中断了。")}

func character_ending(id: String) -> Dictionary:
	var person = run.actor(id)
	if person.is_empty() or not PERSONAL_QUESTS.has(id):
		return {"name": person.get("name", id), "text": "没有这位同行者的个人记录。"}
	var quest: Dictionary = PERSONAL_QUESTS[id]
	var chosen = _personal_choice(id)
	var result: String = quest.pending
	if person.joined and not chosen.is_empty():
		result = _personal_outcome(id, chosen).ending
	elif person.joined:
		result += "\n虽然一路同行，这件事还没拿定主意。"
	else:
		result += "\n这次没和远征队一起走，这件事也还等着本人拿主意。"
	if run.data.status == "won":
		result = "诸神已经停战。\n\n" + result
	else:
		result = "这次远征没能让战争停下来。\n\n" + result
	if person.hp <= 0:
		var injured_subject: String = person.name + "的化身" if Catalog.COMPANIONS[id].race == "神" else person.name
		result += "\n%s伤得很重，还需要人照顾。要做的事得等伤好一些再去做。" % injured_subject
	return {"name": person.name, "text": result}
