const CHARACTER_BEHAVIOR = {
	"cen": ["话少，护短，宁愿丢掉军职也不肯只救本族", "我跟你走。到时候要是得撤，先告诉我出了什么事。", "扎营前先看看能往哪儿撤。地方再舒服，一出事走不了也不行。", "往旁边站站。事情办完了，也得让后面的人有路走。"],
	"lorne": ["机智健谈的老信使，拿官威取乐，对河口旧友放心不下", "成。路上要是碰见从河口来的人，叫我一声。我有个老朋友还困在那儿。", "干粮分开装。摔坏一只袋子，至少还剩一顿饭。年轻时我嫌麻烦，饿过两天就不嫌了。", "歇够了就接着找路。将军坐着等人来抬，咱们送信的可没那个福气。"],
	"eve": ["耐心，诊断时直言，敢违抗军令", "我跟你走。说好了，治伤得听我的。伤员是哪边的人，我都照样治。", "有伤别拿披风盖着。能忍疼，不等于伤口会自己好。", "先看看还有没有人需要止血。别光顾着听谁吵得响。伤得重的人，有时连喊都喊不出来。"],
	"grit": ["寡言记仇，珍视使者与龙族声望，不肯轻易放过敌人", "我跟你去。碰上黑旗军，叫我。他们杀了我的使者，我还没跟他们算账。", "要我扛重物就说。要我忘掉仇人，省口气。", "活下来的未必肯道谢。以前挡过我的人，别以为停了战就能和我做朋友。"],
	"ember": ["守约索价，以战火炫耀力量，想独占火源与军炉", "可以。同行归同行，哪天要我烧城，咱们得另谈。", "取暖的火是一个价，烧穿城墙又是一个价。别把两件事一起塞给我。", "火熄了，报酬可不会跟着消失。许过什么，我记得。"],
	"tide": ["熟悉河道，尖锐不让步，善用闸工与船家的交情", "一起走吧。沿河的路听我的，水可不会因为谁嗓门大就绕着走。", "水边扎营得找高一点的地方。鞋湿了还能烤干，睡着了被水冲走，你找谁说理？", "先离开低处。水还没退呢。让那些人争功去，咱们先上高处。"],
	"frost_archer": ["固执记仇，护着供养弓队的四村，把粮食也看作权力", "我跟你走。不过给我送粮的那四个村子，我还得管。别指望我把他们丢下。", "剩下多少干粮，自己心里有数。许给别人的那份，别饿了就装忘记。", "要分东西，先看看手里的东西够几个人。我不会拿自己人的饭，换所有人一句好话。"],
	"storm_caller": ["自负好胜，迷恋破舰雷术，既想遇见对手又不肯被超过", "好，路上有硬茬先叫我。可别拿劈柴这种事来试我的雷。", "别碰杖头。不是摆威风，我有时候也猜不准下一道火花往哪儿窜。", "收手倒容易。难的是下回还能不能劈得更准、更狠。"],
	"wind_runner": ["爱赌爱出风头，擅长伪装诱敌，不甘心做稳妥的后手", "我跟你。真要有人先跑出去，让我来。", "我去看前头也得回来吃饭。你要找我，先朝上风处喊，别闷头跟进岔路。", "趁敌人还没反应过来，咱们先看看哪条路能走。"],
	"stone_guard": ["倔强，护工匠的命，绝不许军官把工人当爆破耗材", "我去。要我撑住出口可以，要我把人封在里面不行。", "绳子磨起毛就换。舍不得这一截，掉下去可不只赔根绳子。", "先检查脚下。争功的人踩塌支架，也不会比别人摔得轻。"],
	"ironforge": ["好胜暴躁，仍爱造兵器，想亲手胜过自己最出名的破城弩", "我跟你走。捡到刻了我印记的兵器，先留给我看看。", "锤子别借来砸干粮。你嫌磨刀慢，就别拿刀撬石头。", "坏了能修，拆了也能再造。可别拿外行的敲法糟蹋好铁。"],
	"granite": ["严肃守旧，偏袒城内士族，也想握住自己的守门兵", "我可以跟你走。可城门该交给谁管，我们迟早得谈。", "守门的得吃饱，也得知道听谁的。光把门造厚，守不住一座城。", "门内的人要安稳，门外的人要进来。真轮到我选，我先顾城里。"],
	"mistleaf": ["冷静寡言，善算撤离时辰，危急时敢舍弃未撤出的队伍", "走吧。我替你看后路，到了非撤不可的时候，可别等所有人都赞成。", "过桥前先找找附近哪里水浅。等要撤了再找，走在最后的人可等不起。", "别都挤在同一个出口。哪怕只剩最后几个人，也得有人看着后面。"],
	"willow": ["和气精明，偏袒本族，惯于拿旧盟友的信任换利益", "一起走吧。山口那几位商人，你有认识的吗？路上说不定得找他们帮忙。", "先吃吧。空着肚子谈买卖，别人给碗饭，你都觉得欠他个人情。", "朋友多不是坏事。只是下回求人之前，最好想想对方想从你这儿拿什么。"],
	"ashhorn": ["彬彬有礼，把粮食和人的困境用来买兵争权", "乐意同行。路上有什么买卖，记得也让我听听。", "饿着的兵比将军诚实。粮车往哪儿走，比旗上画什么更有意思。", "现在谈价，通常比开打以前贵。你看，我并不总是催人动手。"],
	"oathguard": ["寡言严苛的恶魔，按原话履约，寸步不让报酬与关门权", "这一路我答应护着你们。谁掉队了，我会回头找。要我守一座城，那得另谈。", "守多久，护到哪里，先说清楚。临时添的事，要另算价。", "先前答应的，我不会少做。没答应的，别用一句应该就添进来。"],
	"highdrake": ["庄重自负，愿护山下盟友，也想推翻长老的禁令争席位", "我跟你走。山下有人来求援，我还是会去，不管长老怎么说。", "山坡上别把帐篷挨着搭。真要救人，得留出能落脚的空地。", "别替别人决定该不该谢我。肯一起守山口，比说好话有用。"],
	"cloudscale": ["热烈好奇，享受护航声望，也珍惜随时飞走的自由", "好啊，一起走。先说好，别替我答应给哪支军队办事。", "铜铃别乱敲。一听铃响得急，我就想往河边飞。你可别哪天拿它叫我吃饭。", "地上绕路太慢了。可真要我带人飞，也得先问对方敢不敢睁眼。"],
	"longroad": ["圆滑幽默，善于两面交易，遇到灭口威胁先保自己", "一起走吧。关口要是有人乱收钱，让我先跟他聊聊。", "问路问价都可以交给我。至于要不要信，最好自己也留个心眼。", "别因为做成一桩买卖，就以为下一桩也是同一个价。"],
	"fieldmedic": ["严厉的战地医师，敢从军官手里抢伤员，憎恶把病人当兵器", "走。有人拿军衔插队，我骂起来你别劝。", "睡不好、手发抖，都来找我。等到握不住水杯才说，嫌自己的伤好得太快吗？", "能说话的伤员，就问本人想去哪儿。旁人替他答，我可不听。"],
	"siltguard": ["多疑护城，明知自己有罪，仍拿秘密谋兵权和活路", "我跟你去。城里的事，别替我答应任何人。", "水声一变，就离岸远些。水一涨就没路走了。别为了多睡会儿，在岸边赖着。", "别急着问谁该受赏。先看看谁还带着兵，谁已经没得选了。"],
	"seasons": ["四季神的化身，慷慨任性，既赐收成也肯让一谷挨冻", "我借这副模样走一段。嫌路长了，可不一定陪你走到底。", "把田里的歌唱一段。我喜欢听人唱，至于还想听多久，要等唱完才知道。", "你们盼着雪化，可路一通，兵车也能上山。来求我之前，先想想这事。"],
	"earth_god": ["大地神的化身，沉默专断，肯给退路，也会把不服从者留在山外", "我沿这条路走一段。哪座山要动，由我决定。", "站稳。你觉得石头没在动，是你等得还不够久。", "人走得急，山可不急。催我，不会让路短一寸。"],
	"sky_god": ["天空神的化身，骄傲任性，愿赐顺风，也会因遭欺骗迁怒整条河", "我就用这副样子跟你走一段。风想转向时，你会先听见。", "别拿旗杆挡着我看云。我肯停下来，不是要听谁在我面前发令。", "顺风可以给，下一次却不一定。别把我的一时高兴当成你们的规矩。"],
	"snowforge": ["强硬敢赌，护旧部，反对军官专权，也想有自己的工坊和追随者", "走吧。兵器能再打，人死了可不能拿铁补上。", "把重东西压低些。真要逃，别让一箱铁绊倒扛它的人。", "活人先走，兵器后搬。舍不得放手的，叫他自己来背。"],
}

const BACKGROUNDS = {
	"cen": "黑旗围住王城时，议会只准我带精灵出城。我带弓手抢了哨塔，在城门那儿守了一夜，让等在门下的人都能出去。军职丢了，一些跟我夺塔的人也没回来。城门开了，我不后悔。可那些弓手以后得能自己撤，不能总等我下令。",
	"lorne": "围城时，我把求援信缝进靴子，趁守军换哨溜了出去。箭擦掉了半只耳朵，我还得跟守河口的老兵说笑，免得他们以为援兵就在身后。援兵没按时来，老友赫辛带着散兵守住了渡口，给我留过一条退路。前些日子我经过对岸，认出了他们挂在旧磨坊的缺角灯。他们还在守，里面还有走不了的人。",
	"eve": "霜谷缺粮的时候，各家把粮仓当征兵点。我守过一所被围的医院，守军只肯给还能归队的人药。我拆掉军医牌，把攻城的伤兵也抬了进来。伤好了想去哪儿，让病人自己说。军医也不能替将军把人送回去。",
	"grit": "黑旗扣住我的使者，把人杀了。我变回龙身，拆了重弩和外墙，也压塌了城外收留难民的堡。敌军退了，我仍毁掉最后一座箭塔。使者本来是去谈停战的，他们却拿尸首示威。这仇我要报。堡里的人要找我算账，我也认。",
	"ember": "守军拿家里祖传的火请我去解围。我收了祖火，把俘虏赶进敌阵，从两边放火。雇主后来求我放那批俘虏走。那是另一桩买卖，他没付钱。仗我打了，报酬就是我的。想把火买回去，他得另出我看得上的东西。",
	"tide": "我替船家测过这条河。风暴那夜，我在高岸看见城主的闸兵上了闸楼，我看见泽栅拔掉闸上的铁销。那之后，水才淹进河边关俘虏的营地。后来修闸的老工匠带我爬上绞盘，指出铁上那道新伤。城主一直说是天上的风害了人，可他还让原来那批兵守着闸。下游的人一听见水响，就往高坡跑。",
	"frost_archer": "霜谷冻住以后，我带弓手抢过军粮。守粮的人也来自挨饿的村子，我还是让人朝他们放箭。四个村子供养我的弓队，我先让他们拿够，才给别人开仓。问我偏不偏心？偏。下次缺粮，我也得先顾给我送过饭的人。",
	"storm_caller": "风暴封河时，一位执政官请我送他过河，代价是忘掉家乡话。我原本只需劈开一艘拦路军舰，可我想试试把雷连着打出去，最后沉了三艘。人送到了，他连同乡的话都听不懂。我记得他付的价，也记得那三道雷。我还想知道自己能打到哪一步。",
	"wind_runner": "黑旗进城前，我冒充王军信使，送假退兵令骗过三座哨塔。主力趁乱走掉，殿后的还在等真的撤退命令。我知道那会把他们留下，还是做了。旧印我没扔，可黑旗后来查过那张脸；同一身打扮再跑过去，可不是机灵，是找死。",
	"stone_guard": "城邦命我炸山路，堵敌军前锋。多兰克震开山脊，我才发现军图漏掉的深巷里还有矿工。我撑住另一头出口，先把矿队带出来，敌军也趁机跑了。军官说我不听军令。再让我把工人埋在矿里，我也一样不会听。",
	"ironforge": "黑旗的破城弩是我造的。我知道它会往城里射，只是太想赢过城邦的锻匠。后来从弟弟身上拔出来的箭，也带我的锻印。我没因此讨厌兵器。我想做能拆掉那种弩的东西，也想让别人知道，我不只会造那一架。",
	"granite": "断山以后，议会命我封门。我从备用门接进士族家属，没把那条路告诉普通守军。外头有人死了。议会知道，仍把钥匙交给我。这事没什么误会。城里的人养着守军，我当时就是先保他们。",
	"mistleaf": "追兵快顺着浮桥冲进难民营时，我命弓手射断自己人的桥。对岸还有几队没撤完，风暴也没给他们留船。有人叫我叛徒。再碰上这种事，我也未必会等。可对岸的人至少该有另一条退路。",
	"willow": "我替林中的议会跑过边地生意。山下守路的人喝过我的酒，也肯让我带人走林子里的小路。城邦肯跟我谈土地和征兵的事。我先顾林里的人，交情能换到什么，我也会算。你想托我找这些人帮忙，先问问我要什么。",
	"ashhorn": "议会请我保住王印，答应让我挑下一任守边的将军。我保住了王印，又用议会的粮买通赫罗将军，让他带兵离开城外防线。城外死了人，他的兵却吃饱了。赫罗现在宁愿先问我的粮车在哪儿。我喜欢懂得问这句话的将军。",
	"oathguard": "城邦把最后一座要塞给我，换我守到休战，不许任何军队入堡。城主投了敌，后来带着金库里的钱来求我开门，我没开。他的伤兵也被挡在外面。到期以后我还了他家的祖像，没还要塞。堡垒是报酬，不是替他寄存的东西。",
	"highdrake": "山腹裂开时，长老不许龙离开族界。我还是变回龙身撑山，又震塌山脊挡追兵。山下几户人家的房子也塌了。长老把我赶出去以后，我和附近几个村子说好，有事就互相帮忙。房子塌了，他们尽管来找我算账。长老当初不让我们下山，这事我也要找他们说。",
	"cloudscale": "军舰冒挂求救的白布，莱文索就让河上又起了风。民船也翻了。我带年轻的龙去拖船，后来给船家找了一条能能绕开两岸巡逻船的小河道，用铜铃指路。那只是一次救急，还没有谁常年守在那里。两岸都说我替他们办事，真会往自己脸上贴金。",
	"longroad": "围城时，我把敌军从哪几面包过来的消息分成几份，卖给三个领主。每个人都买到了真消息，偏偏都少了能让自己撤出去的那一段。他们拿着消息打起来，我拿着钱出了城。你觉得这事卑鄙，我也不跟你争。可每桩生意都让别人高兴，我早就活不到今天了。",
	"fieldmedic": "我以前跟的将军求过卡德兰，让伤得快死的人接着打。那些还活着的伤兵被神力催着站起来，听见战鼓就往前冲，伤口并没长好。有个人刚学会拄拐，回来时断骨又刺出了皮肉。我教两边的军医看伤兵发作前怎么发抖，也亲手废了那个将军握剑的手。黑旗从那以后就通缉我。他们管这叫损失一名好将军。",
	"siltguard": "那次刮大风，我明知道河边地势低，营里还关着俘虏，还是拔掉铁销开了闸。上岸的敌军淹死了，营里的俘虏也没活下来。城主把洪水全推给天空神，我收了守备的职位。闸销我留着。罪在我身上不假，可城主想让我一个人扛，也没那么便宜。",
	"seasons": "谷仓里的人求我除虫，我便让冬天早到。仓里的粮保住了，邻谷没收的庄稼全冻坏了。他们现在不肯给我献新麦，我也听见了。我犯不着去一块田一块田地解释。倒是用这副样子出门，才知道那些人背地里都怎么骂我。",
	"earth_god": "城邦来求铁时，答应不挖穿撑住山的岩层。后来他们挖穿了，还来求我把山震塌，挡住敌人的援军。我让山动了，矿工和逃难的人也被困在里面。我听得见。你眼前这副样子只是我的化身，山下的人谁也没见过。可他们认不认得我，都不能这么挖我的山。",
	"sky_god": "船工求我让风停一夜，好送伤员和家人过河。我给过。军舰挂着同样的白布混进来，我便让整条河重新起风，没撤完的民船也翻了。军舰敢骗我，我就让整条河起风。别替我说我只想罚军舰。岸上的人没见过这副化身，却有不少人对着天骂我。",
	"snowforge": "断山后，城主只准自家人先走矿道。我打开军械库，把里面的兵器拿出去，换那些被困的人先下山。旧部替我撬锁，工匠替我运铁。城邦少了兵器，说我是弃城的军官；现在有人愿意跟着我，他们又怕我回去跟他们抢位子。我不打算跪着求他们改口。",
